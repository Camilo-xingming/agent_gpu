// Simple Complete Atomic Test
// Tests all 8 atomic ops, writes count to 0x2000

.entry atomic_simple_all:
    mov.u32 r0, %laneid
    bra.nz r0, DONE

    mov.u32 r10, 0x1000      // Atomic target
    mov.u32 r31, 0           // Counter

    // 1: ATOM.ADD
    mov.u32 r1, 100
    st.global.u32 [r10], r1
    mov.u32 r2, 50
    atom.add.s32 r3, [r10], r2
    add.s32 r31, r31, 1

    // 2: ATOM.MIN
    mov.u32 r1, 75
    atom.min.s32 r3, [r10], r1
    add.s32 r31, r31, 1

    // 3: ATOM.MAX
    mov.u32 r1, 200
    atom.max.s32 r3, [r10], r1
    add.s32 r31, r31, 1

    // 4: ATOM.AND
    mov.u32 r1, 0xFF00
    st.global.u32 [r10], r1
    mov.u32 r2, 0xF0F0
    atom.and.b32 r3, [r10], r2
    add.s32 r31, r31, 1

    // 5: ATOM.OR
    mov.u32 r1, 0x0FFF
    atom.or.b32 r3, [r10], r1
    add.s32 r31, r31, 1

    // 6: ATOM.XOR
    mov.u32 r1, 0x00FF
    atom.xor.b32 r3, [r10], r1
    add.s32 r31, r31, 1

    // 7: ATOM.EXCH
    mov.u32 r1, 0xBEEF
    atom.exch.b32 r3, [r10], r1
    add.s32 r31, r31, 1

    // 8: ATOM.CAS
    mov.u32 r1, 0xBEEF
    mov.u32 r2, 0xCAFE
    atom.cas.b32 r3, [r10], r1, r2
    add.s32 r31, r31, 1

    // Write r31 (should be 8) to 0x2000
    mov.u32 r20, 0x2000
    st.global.u32 [r20], r31

DONE:
    exit
.end
