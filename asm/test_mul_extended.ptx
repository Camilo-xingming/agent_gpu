// Extended multiplication operations test
// Tests: mul.lo, mul.hi, mad, mul24, div, rem
// Uses bra.nz for comparisons

.entry test_mul_extended:
    // Test 1: mul.lo.u32 - lower 32 bits
    mov.u32 r0, 100
    mov.u32 r1, 200
    mul.lo.u32 r2, r0, r1     // 100 * 200 = 20000
    sub.s32 r30, r2, 20000
    bra.nz r30, FAIL

    // Test 2: mul.hi.u32 - upper 32 bits (large products)
    // 0x80000000 = 2^31, build via shift
    mov.u32 r3, 0x8000
    shl.b32 r3, r3, 16        // r3 = 0x80000000
    mov.u32 r4, 4
    mul.hi.u32 r5, r3, r4     // (2^31 * 4) >> 32 = 2
    sub.s32 r30, r5, 2
    bra.nz r30, FAIL

    // Test 3: mul.lo.s32 - signed multiply (-10 * 5 = -50)
    mov.s32 r6, 0
    mov.s32 r7, 10
    sub.s32 r6, r6, r7        // r6 = -10
    mov.s32 r7, 5
    mul.lo.s32 r8, r6, r7     // -10 * 5 = -50
    // Verify by adding 50, result should be 0
    add.s32 r9, r8, 50
    bra.nz r9, FAIL

    // Test 4: mad.lo.u32 - multiply-add
    mov.u32 r10, 7
    mov.u32 r11, 8
    mov.u32 r12, 100
    mad.lo.u32 r13, r10, r11, r12   // 7*8 + 100 = 156
    sub.s32 r30, r13, 156
    bra.nz r30, FAIL

    // Test 5: mad.lo.s32 - signed multiply-add
    mov.s32 r14, 0
    mov.s32 r15, 5
    sub.s32 r14, r14, r15     // r14 = -5
    mov.s32 r15, 6
    mov.s32 r16, 50
    mad.lo.s32 r17, r14, r15, r16   // -5*6 + 50 = 20
    sub.s32 r30, r17, 20
    bra.nz r30, FAIL

    // Test 6: mul24.lo.u32 - 24-bit multiply
    mov.u32 r18, 1000
    mov.u32 r19, 3
    mul24.lo.u32 r20, r18, r19   // 1000 * 3 = 3000
    sub.s32 r30, r20, 3000
    bra.nz r30, FAIL

    // Test 7: div.u32 - unsigned division
    mov.u32 r21, 100
    mov.u32 r22, 7
    div.u32 r23, r21, r22     // 100 / 7 = 14
    sub.s32 r30, r23, 14
    bra.nz r30, FAIL

    // Test 8: rem.u32 - unsigned remainder
    rem.u32 r24, r21, r22     // 100 % 7 = 2
    sub.s32 r30, r24, 2
    bra.nz r30, FAIL

    // Test 9: div.s32 - signed division (-100 / 7 = -14)
    mov.s32 r25, 0
    mov.s32 r26, 100
    sub.s32 r25, r25, r26     // r25 = -100
    div.s32 r26, r25, r22     // -100 / 7 = -14
    // Verify: -14 + 14 = 0
    add.s32 r27, r26, 14
    bra.nz r27, FAIL

    // Test 10: rem.s32 - signed remainder (-100 % 7 = -2)
    rem.s32 r28, r25, r22     // -100 % 7 = -2
    // Verify: -2 + 2 = 0
    add.s32 r29, r28, 2
    bra.nz r29, FAIL

    // Test 11: Large multiply check (65535^2)
    mov.u32 r30, 0xFFFF       // 65535
    mul.lo.u32 r31, r30, r30  // 65535^2 = 0xFFFE0001
    // Check low bits: should end in 0001
    and.b32 r0, r31, 0xFFFF
    sub.s32 r1, r0, 1
    bra.nz r1, FAIL

    // Test 12: Multiply by zero
    mov.u32 r1, 12345
    mov.u32 r2, 0
    mul.lo.u32 r3, r1, r2
    bra.nz r3, FAIL

    // Write success marker
    mov.u32 r4, 0x2000
    mov.u32 r5, 0xCAFE
    st.global.u32 [r4], r5
    exit

FAIL:
    mov.u32 r4, 0x2000
    mov.u32 r5, 0xDEAD
    st.global.u32 [r4], r5
    exit
.end
