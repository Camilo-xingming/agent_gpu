// Vector addition with atomic accumulation (reduction)
// Tests: Per-lane atomic operations, atomic queue, shared memory atomics
// Scenario: Sum all elements of a vector using atomic add
//
// Track 1 Optimization Targets:
// - Per-lane atomic throughput >10x improvement
// - Multi-warp atomic queue reduces stalls >50%

.entry bench_vecadd_atomic:
    // Register allocation:
    // r0  = laneid
    // r1  = thread global index
    // r2-r3 = input address, output address
    // r4-r7 = computation temps
    // r10-r15 = shared memory temps
    // r20 = result accumulator
    // r30 = status/comparison

    mov.u32 r0, %laneid
    mov.u32 r1, %tid.x

    // Input array at 0x1000, output (sum) at 0x2000
    mov.u32 r2, 0x1000
    mov.u32 r3, 0x2000

    // Calculate per-thread address: input + laneid * 4
    shl.b32 r4, r0, 2
    add.s32 r5, r2, r4

    // Load input value
    ld.global.u32 r6, [r5]

    //==========================================================
    // Test 1: Per-lane atomic add to shared memory
    // Each lane atomically adds its value to shared accumulator
    //==========================================================

    // Initialize shared memory accumulator (lane 0 only)
    mov.u32 r10, 0x0         // shared memory address
    bra.nz r0, SKIP_INIT
    mov.u32 r11, 0
    st.shared.u32 [r10], r11
SKIP_INIT:

    // Barrier to ensure initialization complete
    bar.sync 0

    // Per-lane atomic add to shared memory
    atom.shared.add.s32 r12, [r10], r6

    // Barrier before reading result
    bar.sync 0

    //==========================================================
    // Test 2: Warp-level shuffle reduction + final atomic
    // More efficient pattern using warp shuffle before atomic
    //==========================================================

    // Warp shuffle reduction
    mov.u32 r20, r6    // Start with own value

    // Shuffle down and add (log2 reduction)
    shfl.sync.down.b32 r21, r20, 16, 31, 0xffffffff
    add.s32 r20, r20, r21

    shfl.sync.down.b32 r21, r20, 8, 31, 0xffffffff
    add.s32 r20, r20, r21

    shfl.sync.down.b32 r21, r20, 4, 31, 0xffffffff
    add.s32 r20, r20, r21

    shfl.sync.down.b32 r21, r20, 2, 31, 0xffffffff
    add.s32 r20, r20, r21

    shfl.sync.down.b32 r21, r20, 1, 31, 0xffffffff
    add.s32 r20, r20, r21

    // Only lane 0 performs final atomic to global memory
    bra.nz r0, SKIP_ATOMIC

    // Atomic add warp sum to global output
    atom.global.add.s32 r22, [r3], r20

SKIP_ATOMIC:

    //==========================================================
    // Test 3: Multiple concurrent atomics (queue stress test)
    // All lanes do atomics to test queue depth and throughput
    //==========================================================

    // Each lane atomically increments a counter at its own address
    mov.u32 r25, 0x3000          // Counter base
    add.s32 r26, r25, r4         // Per-lane counter address

    // Initialize counter
    mov.u32 r27, 0
    st.global.u32 [r26], r27

    // Do 4 atomic increments per lane
    mov.u32 r28, 1
    atom.add.s32 r29, [r26], r28
    atom.add.s32 r29, [r26], r28
    atom.add.s32 r29, [r26], r28
    atom.add.s32 r29, [r26], r28

    // Verify counter = 4
    ld.global.u32 r29, [r26]
    sub.s32 r30, r29, 4
    bra.nz r30, FAIL

    //==========================================================
    // Verification and success marker
    //==========================================================

    // Only lane 0 writes success marker
    bra.nz r0, DONE

    // Read shared memory result
    ld.shared.u32 r15, [r10]

    // For 32 lanes with values 0-31, sum = 496
    // (But we used loaded values, so just check non-zero)
    bra.z r15, FAIL

    // Write success
    mov.u32 r30, 0x4000
    mov.u32 r31, 0xCAFE
    st.global.u32 [r30], r31
    bra DONE

FAIL:
    mov.u32 r30, 0x4000
    mov.u32 r31, 0xDEAD
    st.global.u32 [r30], r31

DONE:
    exit
.end
