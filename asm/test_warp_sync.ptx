// Warp Synchronization Test - Very Simple
// Tests that bar.sync completes without hanging
// Uses bra.nz for comparisons

.entry test_warp_sync:
    mov.u32 r0, %laneid

    // Only lane 0 runs tests
    bra.nz r0, SKIP_TEST

    // Test 1: Write value, sync (nop for single lane), verify
    mov.u32 r1, 0x1000
    mov.u32 r2, 42
    st.global.u32 [r1], r2

    // Single lane test - bar.sync should be a no-op or immediate
    // bar.sync 0

    // Verify the write completed
    ld.global.u32 r3, [r1]
    sub.s32 r30, r3, 42
    bra.nz r30, FAIL

    // Test 2: Multiple writes and reads
    mov.u32 r4, 0x1004
    mov.u32 r5, 100
    st.global.u32 [r4], r5

    mov.u32 r6, 0x1008
    mov.u32 r7, 200
    st.global.u32 [r6], r7

    // Verify
    ld.global.u32 r8, [r4]
    sub.s32 r30, r8, 100
    bra.nz r30, FAIL

    ld.global.u32 r9, [r6]
    sub.s32 r30, r9, 200
    bra.nz r30, FAIL

    // Test 3: Sum verification
    add.s32 r10, r8, r9   // 100 + 200 = 300
    sub.s32 r30, r10, 300
    bra.nz r30, FAIL

    // Write success marker
    mov.u32 r21, 0x2000
    mov.u32 r22, 0xCAFE
    st.global.u32 [r21], r22
    bra DONE

SKIP_TEST:
    bra DONE

FAIL:
    mov.u32 r21, 0x2000
    mov.u32 r22, 0xDEAD
    st.global.u32 [r21], r22

DONE:
    exit
.end
