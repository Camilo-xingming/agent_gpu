// Async Copy Test - Simplified
// Tests memory copy patterns (simulating async behavior)
// Uses bra.nz for comparisons

.entry test_async_copy:
    mov.u32 r0, %laneid

    // Only lane 0 runs tests
    bra.nz r0, SKIP_TEST

    // Test 1: Basic copy pattern
    mov.u32 r1, 0x1000      // Source
    mov.u32 r2, 0x1100      // Dest

    // Write source data
    mov.u32 r3, 0xABCD
    st.global.u32 [r1], r3

    // Copy
    ld.global.u32 r4, [r1]
    st.global.u32 [r2], r4

    // Verify
    ld.global.u32 r5, [r2]
    sub.s32 r30, r5, r3
    bra.nz r30, FAIL

    // Test 2: Sequential copy pattern
    mov.u32 r10, 0x1200     // Source array
    mov.u32 r11, 0x1300     // Dest array

    // Write source values
    mov.u32 r12, 10
    mov.u32 r13, 20
    mov.u32 r14, 30
    st.global.u32 [r10+0], r12
    add.s32 r15, r10, 4
    st.global.u32 [r15], r13
    add.s32 r15, r15, 4
    st.global.u32 [r15], r14

    // Copy first element
    ld.global.u32 r16, [r10]
    st.global.u32 [r11], r16

    // Verify
    ld.global.u32 r17, [r11]
    sub.s32 r30, r17, 10
    bra.nz r30, FAIL

    // Test 3: Prefetch-like pattern (write then immediate read)
    mov.u32 r20, 0x1400
    mov.u32 r21, 77
    st.global.u32 [r20], r21
    ld.global.u32 r22, [r20]
    sub.s32 r30, r22, 77
    bra.nz r30, FAIL

    // Write success marker
    mov.u32 r21, 0x2000
    mov.u32 r22, 0xCAFE
    st.global.u32 [r21], r22
    bra DONE

SKIP_TEST:
    bra DONE

FAIL:
    mov.u32 r21, 0x2000
    mov.u32 r22, 0xDEAD
    st.global.u32 [r21], r22

DONE:
    exit
.end
