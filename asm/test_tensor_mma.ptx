// Tensor MMA Operations Test
// Tests matrix multiply-accumulate operations using dp4a
// Uses bra.nz for comparisons
// NOTE: 16-bit immediate limit - build 32-bit constants with shift+or

.entry test_tensor_mma:
    mov.u32 r0, %laneid

    // Only lane 0 runs tests
    bra.nz r0, SKIP_TEST

    // Test 1: Simulated 2x2 matrix multiply using dp4a
    // A row 0 = [1, 2, 0, 0] packed as bytes
    // B col 0 = [1, 0, 0, 0] (identity)
    // Build 0x00000201 (bytes: 1, 2, 0, 0)
    mov.u32 r1, 0x0201      // Low half
    // r1 = 0x0201 (only 16-bit)

    // Build 0x00000001
    mov.u32 r2, 0x0001

    mov.u32 r3, 0
    dp4a.s32.s32 r4, r1, r2, r3   // 1*1 + 2*0 = 1

    sub.s32 r30, r4, 1
    bra.nz r30, FAIL

    // Test 2: Non-identity multiply
    // A[0] = [2, 3, 0, 0] dot B[0] = [1, 1, 0, 0]
    // Build 0x0302
    mov.u32 r1, 0x0302         // [2, 3]

    // Build 0x0101
    mov.u32 r2, 0x0101         // [1, 1]

    mov.u32 r3, 0
    dp4a.s32.s32 r4, r1, r2, r3  // 2*1 + 3*1 = 5

    sub.s32 r30, r4, 5
    bra.nz r30, FAIL

    // Test 3: Accumulate multiple products (simulating FMA)
    mov.u32 r10, 0              // Accumulator

    // Build 0x01010101 (all 1s)
    mov.u32 r1, 0x0101
    mov.u32 r5, 0x0101
    shl.b32 r5, r5, 16
    or.b32 r1, r1, r5          // r1 = 0x01010101

    dp4a.s32.s32 r10, r1, r1, r10    // 4
    dp4a.s32.s32 r10, r1, r1, r10    // 8
    dp4a.s32.s32 r10, r1, r1, r10    // 12

    sub.s32 r30, r10, 12
    bra.nz r30, FAIL

    // Test 4: Large accumulation with 2s and 3s
    mov.u32 r11, 0              // Accumulator

    // Build 0x02020202 (all 2s)
    mov.u32 r1, 0x0202
    mov.u32 r5, 0x0202
    shl.b32 r5, r5, 16
    or.b32 r1, r1, r5          // r1 = 0x02020202

    // Build 0x03030303 (all 3s)
    mov.u32 r2, 0x0303
    mov.u32 r5, 0x0303
    shl.b32 r5, r5, 16
    or.b32 r2, r2, r5          // r2 = 0x03030303

    // 2*3 * 4 = 24 per dp4a
    dp4a.s32.s32 r11, r1, r2, r11    // 24
    dp4a.s32.s32 r11, r1, r2, r11    // 48

    sub.s32 r30, r11, 48
    bra.nz r30, FAIL

    // Test 5: Store and verify matrix element
    mov.u32 r20, 0x2100
    st.global.u32 [r20], r11

    ld.global.u32 r21, [r20]
    sub.s32 r30, r21, 48
    bra.nz r30, FAIL

    // Write success marker
    mov.u32 r21, 0x2000
    mov.u32 r22, 0xCAFE
    st.global.u32 [r21], r22
    bra DONE

SKIP_TEST:
    bra DONE

FAIL:
    mov.u32 r21, 0x2000
    mov.u32 r22, 0xDEAD
    st.global.u32 [r21], r22

DONE:
    exit
.end
