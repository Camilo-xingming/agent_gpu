.entry fp_arith_test:
    // Test FP32 ADD: use integer 10 + 5 = 15 (simpler test that works)
    // For FP, use cvt to create FP from int
    mov.u32 r1, 10
    cvt.rn.f32.s32 r2, r1      // r2 = 10.0f
    mov.u32 r3, 5
    cvt.rn.f32.s32 r4, r3      // r4 = 5.0f
    add.f32 r5, r2, r4         // r5 = 15.0f
    cvt.rzi.s32.f32 r6, r5     // r6 = 15
    mov.u32 r10, 0x1000
    st.global.u32 [r10], r6    // store 15
    exit
.end
