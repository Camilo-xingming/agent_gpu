// Mixed Latency Operations Test
// Tests mix of short and long latency operations
// ALU (1 cycle) vs MUL (multi-cycle) vs MEM (long latency)
// Uses bra.nz for comparisons

.entry test_mixed_latency:
    mov.u32 r0, %laneid

    // Only lane 0 runs tests
    bra.nz r0, SKIP_TEST

    // Test 1: ALU between memory ops (hide latency)
    mov.u32 r1, 0x1000
    mov.u32 r2, 100
    st.global.u32 [r1], r2

    // Do ALU work while memory settles
    mov.u32 r3, 5
    add.s32 r4, r3, 5       // 10
    add.s32 r5, r4, 5       // 15
    add.s32 r6, r5, 5       // 20

    ld.global.u32 r7, [r1]  // Load the stored value
    add.s32 r8, r7, r6      // 100 + 20 = 120

    sub.s32 r30, r8, 120
    bra.nz r30, FAIL

    // Test 2: Interleaved short and long ops
    mov.u32 r1, 3
    mov.u32 r2, 7
    mul.lo.s32 r10, r1, r2  // Long: 21

    // Short ops while MUL runs
    add.s32 r3, r1, r2      // 10
    sub.s32 r4, r2, r1      // 4

    // Use MUL result
    add.s32 r11, r10, r3    // 21 + 10 = 31

    sub.s32 r30, r11, 31
    bra.nz r30, FAIL

    // Test 3: Multiple MULs with ALU fillers
    mov.u32 r1, 2
    mov.u32 r2, 3
    mov.u32 r3, 4
    mov.u32 r4, 5

    mul.lo.s32 r10, r1, r2   // 6
    add.s32 r5, r3, r4       // 9 (filler while MUL runs)
    mul.lo.s32 r11, r3, r4   // 20
    add.s32 r6, r1, r2       // 5 (filler)

    add.s32 r12, r10, r11    // 6 + 20 = 26
    add.s32 r13, r12, r5     // 26 + 9 = 35

    sub.s32 r30, r13, 35
    bra.nz r30, FAIL

    // Test 4: Memory-ALU-Memory pattern
    mov.u32 r1, 0x1010
    mov.u32 r2, 50
    st.global.u32 [r1], r2

    // ALU ops
    mov.u32 r3, 10
    add.s32 r4, r3, 10       // 20
    add.s32 r5, r4, 10       // 30

    ld.global.u32 r6, [r1]   // 50
    add.s32 r7, r6, r5       // 80
    st.global.u32 [r1], r7

    // More ALU
    add.s32 r8, r5, r5       // 60

    ld.global.u32 r9, [r1]   // Should be 80
    sub.s32 r30, r9, 80
    bra.nz r30, FAIL

    // Test 5: Complex mixed pattern
    mov.u32 r1, 0x1020
    mov.u32 r2, 10
    st.global.u32 [r1], r2   // Store 10

    mov.u32 r3, 2
    mov.u32 r4, 3
    mul.lo.s32 r5, r3, r4    // 6

    ld.global.u32 r6, [r1]   // 10
    add.s32 r7, r6, r5       // 16

    mul.lo.s32 r8, r7, r3    // 32

    sub.s32 r30, r8, 32
    bra.nz r30, FAIL

    // Write success marker
    mov.u32 r21, 0x2000
    mov.u32 r22, 0xCAFE
    st.global.u32 [r21], r22
    bra DONE

SKIP_TEST:
    bra DONE

FAIL:
    mov.u32 r21, 0x2000
    mov.u32 r22, 0xDEAD
    st.global.u32 [r21], r22

DONE:
    exit
.end
