// Parallel reduction with atomics and branches
// Tests: Loop reconvergence, stack management, atomic operations, divergent branches
// Scenario: Tree-based parallel reduction with divergent control flow
//
// Track 1-2 Optimization Targets:
// - Loop reconvergence logic correct
// - Stack overflow protection (nested loops/branches)
// - Branch overhead reduction >20%
// - Atomic queue efficiency

.entry bench_parallel_reduction:
    // Register allocation:
    // r0 = laneid
    // r1 = active mask tracking
    // r2-r5 = addresses and offsets
    // r10-r15 = reduction temps
    // r20-r25 = loop counters and values
    // r30 = verification/status

    mov.u32 r0, %laneid

    // Input array at 0x1000 (32 elements, one per lane)
    // Output (partial sums) at 0x2000
    mov.u32 r2, 0x1000
    mov.u32 r3, 0x2000

    // Load per-lane input value
    shl.b32 r4, r0, 2         // byte offset
    add.s32 r5, r2, r4
    ld.global.u32 r10, [r5]   // Each lane has its input value

    //==========================================================
    // Test 1: Tree reduction with divergent branches
    // log2(32) = 5 stages, stride doubles each stage
    //==========================================================

    mov.u32 r11, r10          // Working value
    mov.u32 r20, 1            // stride = 1

REDUCE_LOOP:
    // Check stride < 32
    sub.s32 r30, r20, 32
    shr.s32 r30, r30, 31      // -1 if stride < 32
    bra.z r30, REDUCE_DONE

    // Only lanes where (laneid % (2*stride)) == 0 participate
    shl.b32 r21, r20, 1       // 2 * stride
    sub.s32 r22, r21, 1       // mask = 2*stride - 1
    and.b32 r23, r0, r22      // laneid & mask

    // DIVERGENT BRANCH: Only some lanes continue
    bra.nz r23, SKIP_ADD

    // Add value from lane (laneid + stride)
    // Use shuffle to get partner's value
    shfl.sync.down.b32 r12, r11, r20, 31, 0xffffffff
    add.s32 r11, r11, r12

SKIP_ADD:
    // RECONVERGENCE POINT: All lanes meet here

    // Double stride
    shl.b32 r20, r20, 1

    // Loop back
    bra REDUCE_LOOP

REDUCE_DONE:

    //==========================================================
    // Test 2: Nested divergent control flow (stack stress)
    //==========================================================

    // Outer branch: even vs odd lanes
    and.b32 r25, r0, 1
    bra.nz r25, ODD_PATH

EVEN_PATH:
    // Even lanes: do a small loop
    mov.u32 r26, 0
EVEN_LOOP:
    sub.s32 r30, r26, 4
    shr.s32 r30, r30, 31
    bra.z r30, EVEN_LOOP_END

    // Inner divergence: lanes 0,4,8,... vs 2,6,10,...
    and.b32 r27, r0, 2
    bra.nz r27, EVEN_INNER_B

EVEN_INNER_A:
    add.s32 r11, r11, 1
    bra EVEN_INNER_MERGE

EVEN_INNER_B:
    add.s32 r11, r11, 2

EVEN_INNER_MERGE:
    add.s32 r26, r26, 1
    bra EVEN_LOOP

EVEN_LOOP_END:
    bra MERGE_OUTER

ODD_PATH:
    // Odd lanes: different loop
    mov.u32 r26, 0
ODD_LOOP:
    sub.s32 r30, r26, 3
    shr.s32 r30, r30, 31
    bra.z r30, ODD_LOOP_END

    // Inner divergence for odd lanes
    and.b32 r27, r0, 4
    bra.nz r27, ODD_INNER_B

ODD_INNER_A:
    add.s32 r11, r11, 3
    bra ODD_INNER_MERGE

ODD_INNER_B:
    add.s32 r11, r11, 4

ODD_INNER_MERGE:
    add.s32 r26, r26, 1
    bra ODD_LOOP

ODD_LOOP_END:

MERGE_OUTER:
    // All lanes reconverge here

    //==========================================================
    // Test 3: Deep nesting (stack overflow protection test)
    //==========================================================

    // 8 levels of nesting - should handle without overflow
    mov.u32 r28, 0            // depth counter

    // Level 1
    and.b32 r30, r0, 1
    bra.nz r30, L1_B
L1_A:
    add.s32 r28, r28, 1
    // Level 2
    and.b32 r30, r0, 2
    bra.nz r30, L2_B
L2_A:
    add.s32 r28, r28, 1
    // Level 3
    and.b32 r30, r0, 4
    bra.nz r30, L3_B
L3_A:
    add.s32 r28, r28, 1
    // Level 4
    and.b32 r30, r0, 8
    bra.nz r30, L4_B
L4_A:
    add.s32 r28, r28, 1
    bra L4_MERGE
L4_B:
    add.s32 r28, r28, 2
L4_MERGE:
    bra L3_MERGE
L3_B:
    add.s32 r28, r28, 2
L3_MERGE:
    bra L2_MERGE
L2_B:
    add.s32 r28, r28, 2
L2_MERGE:
    bra L1_MERGE
L1_B:
    add.s32 r28, r28, 2
L1_MERGE:

    // Add depth counter to result
    add.s32 r11, r11, r28

    //==========================================================
    // Test 4: Final atomic accumulation
    //==========================================================

    // All lanes atomically add their final value
    atom.global.add.s32 r29, [r3], r11

    // Barrier to ensure all atomics complete
    bar.sync 0

    //==========================================================
    // Verification (lane 0 only)
    //==========================================================

    bra.nz r0, DONE

    // Load final sum
    ld.global.u32 r15, [r3]

    // Result should be non-zero
    bra.z r15, FAIL

    // Lane 0's tree reduction result should be sum of all inputs
    // After nested branches, additional contributions added
    // Just verify lane 0's value is reasonable (> original sum)

    // Write success
    mov.u32 r30, 0x3000
    mov.u32 r31, 0xCAFE
    st.global.u32 [r30], r31
    bra DONE

FAIL:
    mov.u32 r30, 0x3000
    mov.u32 r31, 0xDEAD
    st.global.u32 [r30], r31

DONE:
    exit
.end
