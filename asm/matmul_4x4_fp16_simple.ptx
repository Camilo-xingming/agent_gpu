// RalphGPU 4x4 FP16 Matrix Multiplication Kernel - No Predication
// C = A * B where A,B are 4x4 FP16, C is 4x4 FP32
// Memory layout (FP16 packed as 2 per 32-bit word):
//   A: 0x1000 (16 FP16 = 8 words = 32 bytes, row-major)
//   B: 0x1020 (16 FP16 = 8 words = 32 bytes, row-major)
//   C: 0x1040 (16 FP32 = 16 words = 64 bytes, row-major)
//
// All threads execute same code (no predication)
// Uses: r1-r8=A matrix, r9-r16=B matrix, r20=accumulator, r21-r24=temps, r30=ptr

.entry matmul_4x4_fp16:
    // ================================================================
    // Load entire matrix A (8 words) into r1-r8
    // ================================================================
    mov.u32 r30, 0x1000         // A base address
    ld.global.u32 r1, [r30]     // r1 = {A[0][1], A[0][0]}
    add.s32 r30, r30, 4
    ld.global.u32 r2, [r30]     // r2 = {A[0][3], A[0][2]}
    add.s32 r30, r30, 4
    ld.global.u32 r3, [r30]     // r3 = {A[1][1], A[1][0]}
    add.s32 r30, r30, 4
    ld.global.u32 r4, [r30]     // r4 = {A[1][3], A[1][2]}
    add.s32 r30, r30, 4
    ld.global.u32 r5, [r30]     // r5 = {A[2][1], A[2][0]}
    add.s32 r30, r30, 4
    ld.global.u32 r6, [r30]     // r6 = {A[2][3], A[2][2]}
    add.s32 r30, r30, 4
    ld.global.u32 r7, [r30]     // r7 = {A[3][1], A[3][0]}
    add.s32 r30, r30, 4
    ld.global.u32 r8, [r30]     // r8 = {A[3][3], A[3][2]}

    // ================================================================
    // Load entire matrix B (8 words) into r9-r16
    // ================================================================
    mov.u32 r30, 0x1020         // B base address
    ld.global.u32 r9, [r30]     // r9 = {B[0][1], B[0][0]}
    add.s32 r30, r30, 4
    ld.global.u32 r10, [r30]    // r10 = {B[0][3], B[0][2]}
    add.s32 r30, r30, 4
    ld.global.u32 r11, [r30]    // r11 = {B[1][1], B[1][0]}
    add.s32 r30, r30, 4
    ld.global.u32 r12, [r30]    // r12 = {B[1][3], B[1][2]}
    add.s32 r30, r30, 4
    ld.global.u32 r13, [r30]    // r13 = {B[2][1], B[2][0]}
    add.s32 r30, r30, 4
    ld.global.u32 r14, [r30]    // r14 = {B[2][3], B[2][2]}
    add.s32 r30, r30, 4
    ld.global.u32 r15, [r30]    // r15 = {B[3][1], B[3][0]}
    add.s32 r30, r30, 4
    ld.global.u32 r16, [r30]    // r16 = {B[3][3], B[3][2]}

    // ================================================================
    // Compute C[0][0]
    // ================================================================
    mov.u32 r30, 0x1040         // C base address

    and.b32 r21, r1, 0xFFFF     // A[0][0]
    and.b32 r22, r9, 0xFFFF     // B[0][0]
    mul.f16 r20, r21, r22
    cvt.f32.f16 r20, r20

    shr.u32 r21, r1, 16         // A[0][1]
    and.b32 r22, r11, 0xFFFF    // B[1][0]
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23

    and.b32 r21, r2, 0xFFFF     // A[0][2]
    and.b32 r22, r13, 0xFFFF    // B[2][0]
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23

    shr.u32 r21, r2, 16         // A[0][3]
    and.b32 r22, r15, 0xFFFF    // B[3][0]
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23

    st.global.f32 [r30], r20
    add.s32 r30, r30, 4

    // ================================================================
    // C[0][1]
    // ================================================================
    and.b32 r21, r1, 0xFFFF
    shr.u32 r22, r9, 16
    mul.f16 r20, r21, r22
    cvt.f32.f16 r20, r20
    shr.u32 r21, r1, 16
    shr.u32 r22, r11, 16
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    and.b32 r21, r2, 0xFFFF
    shr.u32 r22, r13, 16
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    shr.u32 r21, r2, 16
    shr.u32 r22, r15, 16
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    st.global.f32 [r30], r20
    add.s32 r30, r30, 4

    // ================================================================
    // C[0][2]
    // ================================================================
    and.b32 r21, r1, 0xFFFF
    and.b32 r22, r10, 0xFFFF
    mul.f16 r20, r21, r22
    cvt.f32.f16 r20, r20
    shr.u32 r21, r1, 16
    and.b32 r22, r12, 0xFFFF
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    and.b32 r21, r2, 0xFFFF
    and.b32 r22, r14, 0xFFFF
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    shr.u32 r21, r2, 16
    and.b32 r22, r16, 0xFFFF
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    st.global.f32 [r30], r20
    add.s32 r30, r30, 4

    // ================================================================
    // C[0][3]
    // ================================================================
    and.b32 r21, r1, 0xFFFF
    shr.u32 r22, r10, 16
    mul.f16 r20, r21, r22
    cvt.f32.f16 r20, r20
    shr.u32 r21, r1, 16
    shr.u32 r22, r12, 16
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    and.b32 r21, r2, 0xFFFF
    shr.u32 r22, r14, 16
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    shr.u32 r21, r2, 16
    shr.u32 r22, r16, 16
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    st.global.f32 [r30], r20
    add.s32 r30, r30, 4

    // ================================================================
    // C[1][0]
    // ================================================================
    and.b32 r21, r3, 0xFFFF
    and.b32 r22, r9, 0xFFFF
    mul.f16 r20, r21, r22
    cvt.f32.f16 r20, r20
    shr.u32 r21, r3, 16
    and.b32 r22, r11, 0xFFFF
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    and.b32 r21, r4, 0xFFFF
    and.b32 r22, r13, 0xFFFF
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    shr.u32 r21, r4, 16
    and.b32 r22, r15, 0xFFFF
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    st.global.f32 [r30], r20
    add.s32 r30, r30, 4

    // ================================================================
    // C[1][1]
    // ================================================================
    and.b32 r21, r3, 0xFFFF
    shr.u32 r22, r9, 16
    mul.f16 r20, r21, r22
    cvt.f32.f16 r20, r20
    shr.u32 r21, r3, 16
    shr.u32 r22, r11, 16
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    and.b32 r21, r4, 0xFFFF
    shr.u32 r22, r13, 16
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    shr.u32 r21, r4, 16
    shr.u32 r22, r15, 16
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    st.global.f32 [r30], r20
    add.s32 r30, r30, 4

    // ================================================================
    // C[1][2]
    // ================================================================
    and.b32 r21, r3, 0xFFFF
    and.b32 r22, r10, 0xFFFF
    mul.f16 r20, r21, r22
    cvt.f32.f16 r20, r20
    shr.u32 r21, r3, 16
    and.b32 r22, r12, 0xFFFF
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    and.b32 r21, r4, 0xFFFF
    and.b32 r22, r14, 0xFFFF
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    shr.u32 r21, r4, 16
    and.b32 r22, r16, 0xFFFF
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    st.global.f32 [r30], r20
    add.s32 r30, r30, 4

    // ================================================================
    // C[1][3]
    // ================================================================
    and.b32 r21, r3, 0xFFFF
    shr.u32 r22, r10, 16
    mul.f16 r20, r21, r22
    cvt.f32.f16 r20, r20
    shr.u32 r21, r3, 16
    shr.u32 r22, r12, 16
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    and.b32 r21, r4, 0xFFFF
    shr.u32 r22, r14, 16
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    shr.u32 r21, r4, 16
    shr.u32 r22, r16, 16
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    st.global.f32 [r30], r20
    add.s32 r30, r30, 4

    // ================================================================
    // C[2][0]
    // ================================================================
    and.b32 r21, r5, 0xFFFF
    and.b32 r22, r9, 0xFFFF
    mul.f16 r20, r21, r22
    cvt.f32.f16 r20, r20
    shr.u32 r21, r5, 16
    and.b32 r22, r11, 0xFFFF
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    and.b32 r21, r6, 0xFFFF
    and.b32 r22, r13, 0xFFFF
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    shr.u32 r21, r6, 16
    and.b32 r22, r15, 0xFFFF
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    st.global.f32 [r30], r20
    add.s32 r30, r30, 4

    // ================================================================
    // C[2][1]
    // ================================================================
    and.b32 r21, r5, 0xFFFF
    shr.u32 r22, r9, 16
    mul.f16 r20, r21, r22
    cvt.f32.f16 r20, r20
    shr.u32 r21, r5, 16
    shr.u32 r22, r11, 16
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    and.b32 r21, r6, 0xFFFF
    shr.u32 r22, r13, 16
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    shr.u32 r21, r6, 16
    shr.u32 r22, r15, 16
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    st.global.f32 [r30], r20
    add.s32 r30, r30, 4

    // ================================================================
    // C[2][2]
    // ================================================================
    and.b32 r21, r5, 0xFFFF
    and.b32 r22, r10, 0xFFFF
    mul.f16 r20, r21, r22
    cvt.f32.f16 r20, r20
    shr.u32 r21, r5, 16
    and.b32 r22, r12, 0xFFFF
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    and.b32 r21, r6, 0xFFFF
    and.b32 r22, r14, 0xFFFF
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    shr.u32 r21, r6, 16
    and.b32 r22, r16, 0xFFFF
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    st.global.f32 [r30], r20
    add.s32 r30, r30, 4

    // ================================================================
    // C[2][3]
    // ================================================================
    and.b32 r21, r5, 0xFFFF
    shr.u32 r22, r10, 16
    mul.f16 r20, r21, r22
    cvt.f32.f16 r20, r20
    shr.u32 r21, r5, 16
    shr.u32 r22, r12, 16
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    and.b32 r21, r6, 0xFFFF
    shr.u32 r22, r14, 16
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    shr.u32 r21, r6, 16
    shr.u32 r22, r16, 16
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    st.global.f32 [r30], r20
    add.s32 r30, r30, 4

    // ================================================================
    // C[3][0]
    // ================================================================
    and.b32 r21, r7, 0xFFFF
    and.b32 r22, r9, 0xFFFF
    mul.f16 r20, r21, r22
    cvt.f32.f16 r20, r20
    shr.u32 r21, r7, 16
    and.b32 r22, r11, 0xFFFF
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    and.b32 r21, r8, 0xFFFF
    and.b32 r22, r13, 0xFFFF
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    shr.u32 r21, r8, 16
    and.b32 r22, r15, 0xFFFF
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    st.global.f32 [r30], r20
    add.s32 r30, r30, 4

    // ================================================================
    // C[3][1]
    // ================================================================
    and.b32 r21, r7, 0xFFFF
    shr.u32 r22, r9, 16
    mul.f16 r20, r21, r22
    cvt.f32.f16 r20, r20
    shr.u32 r21, r7, 16
    shr.u32 r22, r11, 16
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    and.b32 r21, r8, 0xFFFF
    shr.u32 r22, r13, 16
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    shr.u32 r21, r8, 16
    shr.u32 r22, r15, 16
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    st.global.f32 [r30], r20
    add.s32 r30, r30, 4

    // ================================================================
    // C[3][2]
    // ================================================================
    and.b32 r21, r7, 0xFFFF
    and.b32 r22, r10, 0xFFFF
    mul.f16 r20, r21, r22
    cvt.f32.f16 r20, r20
    shr.u32 r21, r7, 16
    and.b32 r22, r12, 0xFFFF
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    and.b32 r21, r8, 0xFFFF
    and.b32 r22, r14, 0xFFFF
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    shr.u32 r21, r8, 16
    and.b32 r22, r16, 0xFFFF
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    st.global.f32 [r30], r20
    add.s32 r30, r30, 4

    // ================================================================
    // C[3][3]
    // ================================================================
    and.b32 r21, r7, 0xFFFF
    shr.u32 r22, r10, 16
    mul.f16 r20, r21, r22
    cvt.f32.f16 r20, r20
    shr.u32 r21, r7, 16
    shr.u32 r22, r12, 16
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    and.b32 r21, r8, 0xFFFF
    shr.u32 r22, r14, 16
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    shr.u32 r21, r8, 16
    shr.u32 r22, r16, 16
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    st.global.f32 [r30], r20

    exit

.end
