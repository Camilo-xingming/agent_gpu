// Warp reduction test - simplified
// Basic lane operations that don't require special HW
// Uses bra.nz for comparisons

.entry test_warp_redux:
    mov.u32 r0, %laneid

    // Test: Each lane writes its ID to memory
    // Then lane 0 reads back to verify
    mov.u32 r1, 0x1000
    shl.b32 r2, r0, 2    // r2 = lane * 4
    add.s32 r3, r1, r2   // r3 = 0x1000 + lane*4

    // Write lane ID
    st.global.u32 [r3], r0

    // Lane 0: verify lane 0's write
    bra.nz r0, SKIP_VERIFY

    ld.global.u32 r4, [r1]  // Read back addr 0x1000
    bra.nz r4, FAIL         // Lane 0 should have written 0

    // Write success marker
    mov.u32 r10, 0x2000
    mov.u32 r11, 0xCAFE
    st.global.u32 [r10], r11
    bra DONE

SKIP_VERIFY:
    bra DONE

FAIL:
    mov.u32 r10, 0x2000
    mov.u32 r11, 0xDEAD
    st.global.u32 [r10], r11

DONE:
    exit
.end
