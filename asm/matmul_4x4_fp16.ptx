// RalphGPU 4x4 FP16 Matrix Multiplication Kernel
// C = A * B where A,B are 4x4 FP16, C is 4x4 FP32
// Memory layout (FP16 packed as 2 per 32-bit word):
//   A: 0x1000 (16 FP16 = 8 words = 32 bytes, row-major)
//   B: 0x1020 (16 FP16 = 8 words = 32 bytes, row-major)
//   C: 0x1040 (16 FP32 = 16 words = 64 bytes, row-major)
//
// Simple sequential version: thread 0 computes all 16 elements
// Uses: r0=tid, r1-r8=A matrix, r9-r16=B matrix, r20=accumulator, r21-r24=temps
// r29=mask (0xFFFF)

.entry matmul_4x4_fp16:
    // Get thread ID
    mov.u32 r0, %tid.x          // r0 = tid

    // Only thread 0 does the work
    setp.eq.u32 p0, r0, 0       // p0 = (tid == 0)
    @!p0 bra done               // Skip if not thread 0

    // Load mask for extracting low 16 bits
    mov.u32 r29, 0xFFFF         // r29 = mask for low 16-bit extraction

    // ================================================================
    // Load entire matrix A (8 words) into r1-r8
    // A[row][col] with 2 FP16 per word
    // ================================================================
    mov.u32 r30, 0x1000         // A base address
    ld.global.u32 r1, [r30]     // r1 = {A[0][1], A[0][0]}
    add.s32 r30, r30, 4
    ld.global.u32 r2, [r30]     // r2 = {A[0][3], A[0][2]}
    add.s32 r30, r30, 4
    ld.global.u32 r3, [r30]     // r3 = {A[1][1], A[1][0]}
    add.s32 r30, r30, 4
    ld.global.u32 r4, [r30]     // r4 = {A[1][3], A[1][2]}
    add.s32 r30, r30, 4
    ld.global.u32 r5, [r30]     // r5 = {A[2][1], A[2][0]}
    add.s32 r30, r30, 4
    ld.global.u32 r6, [r30]     // r6 = {A[2][3], A[2][2]}
    add.s32 r30, r30, 4
    ld.global.u32 r7, [r30]     // r7 = {A[3][1], A[3][0]}
    add.s32 r30, r30, 4
    ld.global.u32 r8, [r30]     // r8 = {A[3][3], A[3][2]}

    // ================================================================
    // Load entire matrix B (8 words) into r9-r16
    // ================================================================
    mov.u32 r30, 0x1020         // B base address
    ld.global.u32 r9, [r30]     // r9 = {B[0][1], B[0][0]}
    add.s32 r30, r30, 4
    ld.global.u32 r10, [r30]    // r10 = {B[0][3], B[0][2]}
    add.s32 r30, r30, 4
    ld.global.u32 r11, [r30]    // r11 = {B[1][1], B[1][0]}
    add.s32 r30, r30, 4
    ld.global.u32 r12, [r30]    // r12 = {B[1][3], B[1][2]}
    add.s32 r30, r30, 4
    ld.global.u32 r13, [r30]    // r13 = {B[2][1], B[2][0]}
    add.s32 r30, r30, 4
    ld.global.u32 r14, [r30]    // r14 = {B[2][3], B[2][2]}
    add.s32 r30, r30, 4
    ld.global.u32 r15, [r30]    // r15 = {B[3][1], B[3][0]}
    add.s32 r30, r30, 4
    ld.global.u32 r16, [r30]    // r16 = {B[3][3], B[3][2]}

    // ================================================================
    // Compute C[0][0] = A[0][0]*B[0][0] + A[0][1]*B[1][0] + A[0][2]*B[2][0] + A[0][3]*B[3][0]
    // A row 0: r1={A01,A00}, r2={A03,A02}
    // B col 0: r9[15:0]=B00, r11[15:0]=B10, r13[15:0]=B20, r15[15:0]=B30
    // ================================================================
    mov.u32 r30, 0x1040         // C base address

    // Extract A[0][0] (low 16 of r1)
    and.b32 r21, r1, r29
    // Extract B[0][0] (low 16 of r9)
    and.b32 r22, r9, r29
    // FP16 multiply -> FP32
    mul.f16 r20, r21, r22
    cvt.f32.f16 r20, r20        // r20 = A00*B00 in FP32

    // Extract A[0][1] (high 16 of r1)
    shr.u32 r21, r1, 16
    // Extract B[1][0] (low 16 of r11)
    and.b32 r22, r11, r29
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23       // accumulate

    // Extract A[0][2] (low 16 of r2)
    and.b32 r21, r2, r29
    // Extract B[2][0] (low 16 of r13)
    and.b32 r22, r13, r29
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23

    // Extract A[0][3] (high 16 of r2)
    shr.u32 r21, r2, 16
    // Extract B[3][0] (low 16 of r15)
    and.b32 r22, r15, r29
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23       // r20 = C[0][0]

    // Store C[0][0]
    st.global.f32 [r30], r20
    add.s32 r30, r30, 4

    // ================================================================
    // C[0][1] = A[0][0]*B[0][1] + A[0][1]*B[1][1] + A[0][2]*B[2][1] + A[0][3]*B[3][1]
    // B col 1: r9[31:16]=B01, r11[31:16]=B11, r13[31:16]=B21, r15[31:16]=B31
    // ================================================================
    and.b32 r21, r1, r29        // A[0][0]
    shr.u32 r22, r9, 16         // B[0][1]
    mul.f16 r20, r21, r22
    cvt.f32.f16 r20, r20

    shr.u32 r21, r1, 16         // A[0][1]
    shr.u32 r22, r11, 16        // B[1][1]
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23

    and.b32 r21, r2, r29        // A[0][2]
    shr.u32 r22, r13, 16        // B[2][1]
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23

    shr.u32 r21, r2, 16         // A[0][3]
    shr.u32 r22, r15, 16        // B[3][1]
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23

    st.global.f32 [r30], r20
    add.s32 r30, r30, 4

    // ================================================================
    // C[0][2] = A[0][0]*B[0][2] + A[0][1]*B[1][2] + A[0][2]*B[2][2] + A[0][3]*B[3][2]
    // B col 2: r10[15:0]=B02, r12[15:0]=B12, r14[15:0]=B22, r16[15:0]=B32
    // ================================================================
    and.b32 r21, r1, r29        // A[0][0]
    and.b32 r22, r10, r29       // B[0][2]
    mul.f16 r20, r21, r22
    cvt.f32.f16 r20, r20

    shr.u32 r21, r1, 16         // A[0][1]
    and.b32 r22, r12, r29       // B[1][2]
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23

    and.b32 r21, r2, r29        // A[0][2]
    and.b32 r22, r14, r29       // B[2][2]
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23

    shr.u32 r21, r2, 16         // A[0][3]
    and.b32 r22, r16, r29       // B[3][2]
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23

    st.global.f32 [r30], r20
    add.s32 r30, r30, 4

    // ================================================================
    // C[0][3] = A[0][0]*B[0][3] + A[0][1]*B[1][3] + A[0][2]*B[2][3] + A[0][3]*B[3][3]
    // B col 3: r10[31:16]=B03, r12[31:16]=B13, r14[31:16]=B23, r16[31:16]=B33
    // ================================================================
    and.b32 r21, r1, r29        // A[0][0]
    shr.u32 r22, r10, 16        // B[0][3]
    mul.f16 r20, r21, r22
    cvt.f32.f16 r20, r20

    shr.u32 r21, r1, 16         // A[0][1]
    shr.u32 r22, r12, 16        // B[1][3]
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23

    and.b32 r21, r2, r29        // A[0][2]
    shr.u32 r22, r14, 16        // B[2][3]
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23

    shr.u32 r21, r2, 16         // A[0][3]
    shr.u32 r22, r16, 16        // B[3][3]
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23

    st.global.f32 [r30], r20
    add.s32 r30, r30, 4

    // ================================================================
    // Row 1: C[1][0..3] using A row 1: r3={A11,A10}, r4={A13,A12}
    // ================================================================
    // C[1][0]
    and.b32 r21, r3, r29        // A[1][0]
    and.b32 r22, r9, r29        // B[0][0]
    mul.f16 r20, r21, r22
    cvt.f32.f16 r20, r20

    shr.u32 r21, r3, 16         // A[1][1]
    and.b32 r22, r11, r29       // B[1][0]
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23

    and.b32 r21, r4, r29        // A[1][2]
    and.b32 r22, r13, r29       // B[2][0]
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23

    shr.u32 r21, r4, 16         // A[1][3]
    and.b32 r22, r15, r29       // B[3][0]
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23

    st.global.f32 [r30], r20
    add.s32 r30, r30, 4

    // C[1][1]
    and.b32 r21, r3, r29
    shr.u32 r22, r9, 16
    mul.f16 r20, r21, r22
    cvt.f32.f16 r20, r20
    shr.u32 r21, r3, 16
    shr.u32 r22, r11, 16
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    and.b32 r21, r4, r29
    shr.u32 r22, r13, 16
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    shr.u32 r21, r4, 16
    shr.u32 r22, r15, 16
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    st.global.f32 [r30], r20
    add.s32 r30, r30, 4

    // C[1][2]
    and.b32 r21, r3, r29
    and.b32 r22, r10, r29
    mul.f16 r20, r21, r22
    cvt.f32.f16 r20, r20
    shr.u32 r21, r3, 16
    and.b32 r22, r12, r29
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    and.b32 r21, r4, r29
    and.b32 r22, r14, r29
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    shr.u32 r21, r4, 16
    and.b32 r22, r16, r29
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    st.global.f32 [r30], r20
    add.s32 r30, r30, 4

    // C[1][3]
    and.b32 r21, r3, r29
    shr.u32 r22, r10, 16
    mul.f16 r20, r21, r22
    cvt.f32.f16 r20, r20
    shr.u32 r21, r3, 16
    shr.u32 r22, r12, 16
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    and.b32 r21, r4, r29
    shr.u32 r22, r14, 16
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    shr.u32 r21, r4, 16
    shr.u32 r22, r16, 16
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    st.global.f32 [r30], r20
    add.s32 r30, r30, 4

    // ================================================================
    // Row 2: C[2][0..3] using A row 2: r5={A21,A20}, r6={A23,A22}
    // ================================================================
    // C[2][0]
    and.b32 r21, r5, r29
    and.b32 r22, r9, r29
    mul.f16 r20, r21, r22
    cvt.f32.f16 r20, r20
    shr.u32 r21, r5, 16
    and.b32 r22, r11, r29
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    and.b32 r21, r6, r29
    and.b32 r22, r13, r29
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    shr.u32 r21, r6, 16
    and.b32 r22, r15, r29
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    st.global.f32 [r30], r20
    add.s32 r30, r30, 4

    // C[2][1]
    and.b32 r21, r5, r29
    shr.u32 r22, r9, 16
    mul.f16 r20, r21, r22
    cvt.f32.f16 r20, r20
    shr.u32 r21, r5, 16
    shr.u32 r22, r11, 16
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    and.b32 r21, r6, r29
    shr.u32 r22, r13, 16
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    shr.u32 r21, r6, 16
    shr.u32 r22, r15, 16
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    st.global.f32 [r30], r20
    add.s32 r30, r30, 4

    // C[2][2]
    and.b32 r21, r5, r29
    and.b32 r22, r10, r29
    mul.f16 r20, r21, r22
    cvt.f32.f16 r20, r20
    shr.u32 r21, r5, 16
    and.b32 r22, r12, r29
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    and.b32 r21, r6, r29
    and.b32 r22, r14, r29
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    shr.u32 r21, r6, 16
    and.b32 r22, r16, r29
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    st.global.f32 [r30], r20
    add.s32 r30, r30, 4

    // C[2][3]
    and.b32 r21, r5, r29
    shr.u32 r22, r10, 16
    mul.f16 r20, r21, r22
    cvt.f32.f16 r20, r20
    shr.u32 r21, r5, 16
    shr.u32 r22, r12, 16
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    and.b32 r21, r6, r29
    shr.u32 r22, r14, 16
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    shr.u32 r21, r6, 16
    shr.u32 r22, r16, 16
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    st.global.f32 [r30], r20
    add.s32 r30, r30, 4

    // ================================================================
    // Row 3: C[3][0..3] using A row 3: r7={A31,A30}, r8={A33,A32}
    // ================================================================
    // C[3][0]
    and.b32 r21, r7, r29
    and.b32 r22, r9, r29
    mul.f16 r20, r21, r22
    cvt.f32.f16 r20, r20
    shr.u32 r21, r7, 16
    and.b32 r22, r11, r29
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    and.b32 r21, r8, r29
    and.b32 r22, r13, r29
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    shr.u32 r21, r8, 16
    and.b32 r22, r15, r29
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    st.global.f32 [r30], r20
    add.s32 r30, r30, 4

    // C[3][1]
    and.b32 r21, r7, r29
    shr.u32 r22, r9, 16
    mul.f16 r20, r21, r22
    cvt.f32.f16 r20, r20
    shr.u32 r21, r7, 16
    shr.u32 r22, r11, 16
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    and.b32 r21, r8, r29
    shr.u32 r22, r13, 16
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    shr.u32 r21, r8, 16
    shr.u32 r22, r15, 16
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    st.global.f32 [r30], r20
    add.s32 r30, r30, 4

    // C[3][2]
    and.b32 r21, r7, r29
    and.b32 r22, r10, r29
    mul.f16 r20, r21, r22
    cvt.f32.f16 r20, r20
    shr.u32 r21, r7, 16
    and.b32 r22, r12, r29
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    and.b32 r21, r8, r29
    and.b32 r22, r14, r29
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    shr.u32 r21, r8, 16
    and.b32 r22, r16, r29
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    st.global.f32 [r30], r20
    add.s32 r30, r30, 4

    // C[3][3]
    and.b32 r21, r7, r29
    shr.u32 r22, r10, 16
    mul.f16 r20, r21, r22
    cvt.f32.f16 r20, r20
    shr.u32 r21, r7, 16
    shr.u32 r22, r12, 16
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    and.b32 r21, r8, r29
    shr.u32 r22, r14, 16
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    shr.u32 r21, r8, 16
    shr.u32 r22, r16, 16
    mul.f16 r23, r21, r22
    cvt.f32.f16 r23, r23
    add.f32 r20, r20, r23
    st.global.f32 [r30], r20

done:
    exit

.end
