// LLM Operator Test 2: Simple 2x2 GEMM (Integer)
// Matrix multiply C = A * B where A, B, C are 2x2 matrices
// Used in: Simplified attention/FFN computation
//
// A = [[1, 2],    B = [[5, 6],    C = A*B = [[1*5+2*7, 1*6+2*8],
//      [3, 4]]        [7, 8]]              [3*5+4*7, 3*6+4*8]]
//                                       = [[19, 22],
//                                          [43, 50]]
//
// Memory layout (row-major):
// A at 0x0000: [1, 2, 3, 4]
// B at 0x0010: [5, 6, 7, 8]
// C at 0x1000: [c00, c01, c10, c11] = [19, 22, 43, 50]

.entry llm_gemm_2x2:
    // Load A matrix elements
    mov.u32 r1, 1    // A[0][0]
    mov.u32 r2, 2    // A[0][1]
    mov.u32 r3, 3    // A[1][0]
    mov.u32 r4, 4    // A[1][1]

    // Load B matrix elements
    mov.u32 r5, 5    // B[0][0]
    mov.u32 r6, 6    // B[0][1]
    mov.u32 r7, 7    // B[1][0]
    mov.u32 r8, 8    // B[1][1]

    // Compute C[0][0] = A[0][0]*B[0][0] + A[0][1]*B[1][0] = 1*5 + 2*7 = 19
    mul.lo.u32 r10, r1, r5     // r10 = 1*5 = 5
    mul.lo.u32 r11, r2, r7     // r11 = 2*7 = 14
    add.u32 r20, r10, r11      // r20 = C[0][0] = 19

    // Compute C[0][1] = A[0][0]*B[0][1] + A[0][1]*B[1][1] = 1*6 + 2*8 = 22
    mul.lo.u32 r10, r1, r6     // r10 = 1*6 = 6
    mul.lo.u32 r11, r2, r8     // r11 = 2*8 = 16
    add.u32 r21, r10, r11      // r21 = C[0][1] = 22

    // Compute C[1][0] = A[1][0]*B[0][0] + A[1][1]*B[1][0] = 3*5 + 4*7 = 43
    mul.lo.u32 r10, r3, r5     // r10 = 3*5 = 15
    mul.lo.u32 r11, r4, r7     // r11 = 4*7 = 28
    add.u32 r22, r10, r11      // r22 = C[1][0] = 43

    // Compute C[1][1] = A[1][0]*B[0][1] + A[1][1]*B[1][1] = 3*6 + 4*8 = 50
    mul.lo.u32 r10, r3, r6     // r10 = 3*6 = 18
    mul.lo.u32 r11, r4, r8     // r11 = 4*8 = 32
    add.u32 r23, r10, r11      // r23 = C[1][1] = 50

    // Store C matrix to memory at 0x1000
    mov.u32 r30, 0x1000
    st.global.u32 [r30], r20   // C[0][0] = 19
    mov.u32 r30, 0x1004
    st.global.u32 [r30], r21   // C[0][1] = 22
    mov.u32 r30, 0x1008
    st.global.u32 [r30], r22   // C[1][0] = 43
    mov.u32 r30, 0x100C
    st.global.u32 [r30], r23   // C[1][1] = 50

    exit
