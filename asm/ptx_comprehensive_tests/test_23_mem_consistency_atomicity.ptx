// Test 23: Memory Consistency - Atomicity
// PTX 9.1 Memory Model: Tests atomicity axiom
// Atomic operations must appear to execute atomically
// Multiple threads increment a counter atomically
// Final count must equal number of threads
// Success marker: 0xCAFE at 0x2000

.entry test_mem_consistency_atomicity:
    mov.u32 r0, %tid.x

    // Memory locations
    mov.u32 r10, 0x1000      // counter address
    mov.u32 r14, 0x2000      // result

    // Thread 0 initializes
    bra.nz r0, SKIP_INIT

    mov.u32 r1, 0
    st.global.u32 [r10], r1   // counter = 0

SKIP_INIT:
    bar.sync 0                // all threads wait

    // Each thread atomically increments counter
    mov.u32 r1, 1
    atom.add.s32 r2, [r10], r1

    bar.sync 0                // wait for all increments

    // Only thread 0 verifies
    bra.nz r0, DONE

    // Read final counter value
    ld.global.u32 r1, [r10]

    // Get number of threads (NTID.x)
    mov.u32 r2, %ntid.x

    // Counter should equal ntid.x
    sub.s32 r30, r1, r2
    bra.nz r30, FAIL

    // Success
    mov.u32 r21, 0xCAFE
    st.global.u32 [r14], r21
    bra DONE

FAIL:
    mov.u32 r21, 0xDEAD
    st.global.u32 [r14], r21

DONE:
    exit
.end
