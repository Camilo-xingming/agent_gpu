// Test 13: Video Operations (SIMD)
// Tests: vadd, vsub, vabsdiff, vmin, vmax, dp4a
// Uses 16-bit immediates only (shifts for packed values)
// Success marker: 0xCAFE at 0x2000

.entry test_video_ops:
    mov.u32 r0, %laneid
    bra.nz r0, DONE

    // VADD4: packed 4x8-bit add
    // r1 = {0x01, 0x02, 0x03, 0x04} = 0x04030201
    // r2 = {0x10, 0x20, 0x30, 0x40} = 0x40302010
    // result = {0x11, 0x22, 0x33, 0x44} = 0x44332211
    // Build 0x04030201: 0x0403 << 16 | 0x0201
    mov.u32 r1, 1027        // 0x0403
    shl.b32 r1, r1, 16
    mov.u32 r28, 513        // 0x0201
    or.b32 r1, r1, r28      // 0x04030201

    // Build 0x40302010: 0x4030 << 16 | 0x2010
    mov.u32 r2, 16432       // 0x4030
    shl.b32 r2, r2, 16
    mov.u32 r28, 8208       // 0x2010
    or.b32 r2, r2, r28      // 0x40302010

    vadd4.s32.s32.s32 r3, r1, r2

    // Build expected 0x44332211
    mov.u32 r4, 17459       // 0x4433
    shl.b32 r4, r4, 16
    mov.u32 r28, 8721       // 0x2211
    or.b32 r4, r4, r28      // 0x44332211
    sub.s32 r30, r3, r4
    bra.nz r30, FAIL

    // VSUB4: packed 4x8-bit subtract
    // {0x40, 0x30, 0x20, 0x10} - {0x10, 0x10, 0x10, 0x10} = {0x30, 0x20, 0x10, 0x00}
    // Build 0x10203040: 0x1020 << 16 | 0x3040
    mov.u32 r1, 4128        // 0x1020
    shl.b32 r1, r1, 16
    mov.u32 r28, 12352      // 0x3040
    or.b32 r1, r1, r28      // 0x10203040

    // Build 0x10101010: 0x1010 << 16 | 0x1010
    mov.u32 r2, 4112        // 0x1010
    shl.b32 r2, r2, 16
    mov.u32 r28, 4112       // 0x1010
    or.b32 r2, r2, r28      // 0x10101010

    vsub4.s32.s32.s32 r3, r1, r2

    // Build expected 0x00102030
    mov.u32 r4, 16          // 0x0010
    shl.b32 r4, r4, 16
    mov.u32 r28, 8240       // 0x2030
    or.b32 r4, r4, r28      // 0x00102030
    sub.s32 r30, r3, r4
    bra.nz r30, FAIL

    // VABSDIFF4: packed 4x8-bit absolute difference
    // Build 0x140F0A05: 0x140F << 16 | 0x0A05
    mov.u32 r1, 5135        // 0x140F
    shl.b32 r1, r1, 16
    mov.u32 r28, 2565       // 0x0A05
    or.b32 r1, r1, r28      // 0x140F0A05

    // Build 0x0F140510: 0x0F14 << 16 | 0x0510
    mov.u32 r2, 3860        // 0x0F14
    shl.b32 r2, r2, 16
    mov.u32 r28, 1296       // 0x0510
    or.b32 r2, r2, r28      // 0x0F140510

    vabsdiff4.s32.s32.s32 r3, r1, r2

    // Build expected 0x05050505
    mov.u32 r4, 1285        // 0x0505
    shl.b32 r4, r4, 16
    mov.u32 r28, 1285       // 0x0505
    or.b32 r4, r4, r28      // 0x05050505
    sub.s32 r30, r3, r4
    bra.nz r30, FAIL

    // DP4A: dot product of 4 pairs of signed 8-bit values + accumulator
    // A = {1, 2, 3, 4}, B = {1, 1, 1, 1}, acc = 0
    // result = 1*1 + 2*1 + 3*1 + 4*1 = 10
    // Reuse r1 = 0x04030201 from above, rebuild
    mov.u32 r1, 1027        // 0x0403
    shl.b32 r1, r1, 16
    mov.u32 r28, 513        // 0x0201
    or.b32 r1, r1, r28      // 0x04030201

    // Build 0x01010101
    mov.u32 r2, 257         // 0x0101
    shl.b32 r2, r2, 16
    mov.u32 r28, 257        // 0x0101
    or.b32 r2, r2, r28      // 0x01010101

    mov.u32 r3, 0            // acc = 0
    dp4a.s32.s32 r4, r1, r2, r3
    sub.s32 r30, r4, 10
    bra.nz r30, FAIL

    // DP4A with accumulator
    // result = 10 + 10 = 20
    dp4a.s32.s32 r5, r1, r2, r4
    sub.s32 r30, r5, 20
    bra.nz r30, FAIL

    // VMIN4: packed 4x8-bit min
    // Build 0x10203040
    mov.u32 r1, 4128        // 0x1020
    shl.b32 r1, r1, 16
    mov.u32 r28, 12352      // 0x3040
    or.b32 r1, r1, r28      // 0x10203040

    // Build 0x05153545
    mov.u32 r2, 1301        // 0x0515
    shl.b32 r2, r2, 16
    mov.u32 r28, 13637      // 0x3545
    or.b32 r2, r2, r28      // 0x05153545

    vmin4.s32.s32 r3, r1, r2

    // Build expected 0x05152030
    mov.u32 r4, 1301        // 0x0515
    shl.b32 r4, r4, 16
    mov.u32 r28, 8240       // 0x2030
    or.b32 r4, r4, r28      // 0x05152030
    sub.s32 r30, r3, r4
    bra.nz r30, FAIL

    // VMAX4: packed 4x8-bit max
    vmax4.s32.s32 r3, r1, r2

    // Build expected 0x10203545
    mov.u32 r4, 4128        // 0x1020
    shl.b32 r4, r4, 16
    mov.u32 r28, 13637      // 0x3545
    or.b32 r4, r4, r28      // 0x10203545
    sub.s32 r30, r3, r4
    bra.nz r30, FAIL

    // Success
    mov.u32 r20, 0x2000
    mov.u32 r21, 0xCAFE
    st.global.u32 [r20], r21
    bra DONE

FAIL:
    mov.u32 r20, 0x2000
    mov.u32 r21, 0xDEAD
    st.global.u32 [r20], r21

DONE:
    exit
.end
