// Test 02: ALU Extended Operations
// Tests: min, max, abs, neg, popc, clz, brev
// Uses 16-bit immediates only
// Success marker: 0xCAFE at 0x2000

.entry test_alu_extended:
    mov.u32 r0, %laneid
    bra.nz r0, DONE

    // Test MIN signed
    mov.u32 r1, 100
    mov.u32 r2, 50
    min.s32 r3, r1, r2      // r3 = 50
    sub.s32 r30, r3, 50
    bra.nz r30, FAIL

    // Test MAX signed
    mov.u32 r1, 100
    mov.u32 r2, 50
    max.s32 r3, r1, r2      // r3 = 100
    sub.s32 r30, r3, 100
    bra.nz r30, FAIL

    // Test ABS (-1 via computation: 0 - 1)
    mov.u32 r1, 0
    mov.u32 r2, 1
    sub.s32 r1, r1, r2      // r1 = -1
    abs.s32 r3, r1          // r3 = 1
    sub.s32 r30, r3, 1
    bra.nz r30, FAIL

    // Test NEG
    mov.u32 r1, 5
    neg.s32 r3, r1          // r3 = -5
    add.s32 r4, r3, 5       // should be 0
    bra.nz r4, FAIL

    // Test POPC (population count) - 0xFF has 8 bits set
    mov.u32 r1, 0xFF        // 255 is within 16-bit range
    popc.b32 r3, r1         // r3 = 8
    sub.s32 r30, r3, 8
    bra.nz r30, FAIL

    // Test CLZ (count leading zeros)
    // 0x100 = 256, bit 8 set, CLZ = 23
    mov.u32 r1, 256
    clz.b32 r3, r1          // r3 = 23
    sub.s32 r30, r3, 23
    bra.nz r30, FAIL

    // Test BREV (bit reverse)
    // 0x8000 reversed = 0x00010000 (but we need to verify differently)
    // Use 0x1 reversed = 0x80000000, then shift right 31 = 0x1
    mov.u32 r1, 1
    brev.b32 r3, r1         // r3 = 0x80000000
    shr.u32 r4, r3, 31      // r4 = 1
    sub.s32 r30, r4, 1
    bra.nz r30, FAIL

    // Success
    mov.u32 r20, 0x2000
    mov.u32 r21, 0xCAFE
    st.global.u32 [r20], r21
    bra DONE

FAIL:
    mov.u32 r20, 0x2000
    mov.u32 r21, 0xDEAD
    st.global.u32 [r20], r21

DONE:
    exit
.end
