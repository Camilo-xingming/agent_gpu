// Test 01: ALU Basic Operations
// Tests: add, sub, and, or, xor, shl, shr
// Success marker: 0xCAFE at 0x2000, Fail: 0xDEAD

.entry test_alu_basic:
    mov.u32 r0, %laneid
    bra.nz r0, DONE

    // Test ADD
    mov.u32 r1, 100
    mov.u32 r2, 200
    add.s32 r3, r1, r2      // r3 = 300
    sub.s32 r30, r3, 300
    bra.nz r30, FAIL

    // Test SUB
    mov.u32 r1, 500
    mov.u32 r2, 200
    sub.s32 r3, r1, r2      // r3 = 300
    sub.s32 r30, r3, 300
    bra.nz r30, FAIL

    // Test AND
    mov.u32 r1, 0xFF00
    mov.u32 r2, 0xF0F0
    and.b32 r3, r1, r2      // r3 = 0xF000
    mov.u32 r4, 0xF000
    sub.s32 r30, r3, r4
    bra.nz r30, FAIL

    // Test OR
    mov.u32 r1, 0xFF00
    mov.u32 r2, 0x00FF
    or.b32 r3, r1, r2       // r3 = 0xFFFF
    mov.u32 r4, 0xFFFF
    sub.s32 r30, r3, r4
    bra.nz r30, FAIL

    // Test XOR
    mov.u32 r1, 0xFFFF
    mov.u32 r2, 0x00FF
    xor.b32 r3, r1, r2      // r3 = 0xFF00
    mov.u32 r4, 0xFF00
    sub.s32 r30, r3, r4
    bra.nz r30, FAIL

    // Test SHL
    mov.u32 r1, 1
    shl.b32 r3, r1, 8       // r3 = 256
    sub.s32 r30, r3, 256
    bra.nz r30, FAIL

    // Test SHR
    mov.u32 r1, 256
    shr.u32 r3, r1, 4       // r3 = 16
    sub.s32 r30, r3, 16
    bra.nz r30, FAIL

    // Success
    mov.u32 r20, 0x2000
    mov.u32 r21, 0xCAFE
    st.global.u32 [r20], r21
    bra DONE

FAIL:
    mov.u32 r20, 0x2000
    mov.u32 r21, 0xDEAD
    st.global.u32 [r20], r21

DONE:
    exit
.end
