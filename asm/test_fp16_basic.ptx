// FP16 Basic Operations Test
// Tests half-precision floating point per B300 gap (FP16/BF16)
// Uses bra.nz for comparisons

.entry test_fp16_basic:
    mov.u32 r0, %laneid

    // Only lane 0 runs tests
    bra.nz r0, SKIP_TEST

    // Test 1: FP16 to FP32 conversion
    // FP16: 1.0 = 0x3C00 (sign=0, exp=15, frac=0)
    mov.u32 r1, 0x3C00
    cvt.f32.f16 r2, r1

    // Verify: 1.0f = 0x3F800000
    mov.u32 r3, 0x3F80
    shl.b32 r3, r3, 16      // r3 = 0x3F800000

    sub.s32 r30, r2, r3
    bra.nz r30, FAIL

    // Test 2: FP32 to FP16 conversion
    // 2.0f = 0x40000000
    mov.u32 r4, 0x4000
    shl.b32 r4, r4, 16      // r4 = 0x40000000

    cvt.f16.f32 r5, r4

    // Verify: FP16 2.0 = 0x4000
    mov.u32 r6, 0x4000
    sub.s32 r30, r5, r6
    bra.nz r30, FAIL

    // Test 3: FP16 addition via CVT round-trip
    // Add 1.0 + 1.0 using FP32 then convert back
    mov.u32 r10, 0x3C00      // FP16: 1.0
    cvt.f32.f16 r11, r10     // Convert to FP32

    add.f32 r12, r11, r11    // 1.0 + 1.0 = 2.0 in FP32

    cvt.f16.f32 r13, r12     // Convert back to FP16

    mov.u32 r14, 0x4000      // FP16: 2.0
    sub.s32 r30, r13, r14
    bra.nz r30, FAIL

    // Test 4: Zero handling
    mov.u32 r20, 0           // FP16: +0.0
    cvt.f32.f16 r21, r20
    bra.nz r21, FAIL         // FP32 +0.0 should be 0x00000000

    // Write success marker
    mov.u32 r21, 0x2000
    mov.u32 r22, 0xCAFE
    st.global.u32 [r21], r22
    bra DONE

SKIP_TEST:
    bra DONE

FAIL:
    mov.u32 r21, 0x2000
    mov.u32 r22, 0xDEAD
    st.global.u32 [r21], r22

DONE:
    exit
.end
