// DP4A/DP2A Top-Level Integration Test
// Tests ML acceleration instructions through full GPU pipeline
//
// Test 1: DP4A - INT8 dot product
// a = {0, 0, 2, 1} = 0x0201, b = {0, 0, 3, 3} = 0x0303, c = 10
// Expected: 1*3 + 2*3 + 0 + 0 + 10 = 19
//
// Test 2: DP4A with larger accumulator
// a = {0, 0, 5, 5} = 0x0505, b = {0, 0, 2, 2} = 0x0202, c = 100
// Expected: 5*2 + 5*2 + 0 + 0 + 100 = 120

.entry dp4a_top_test:
    // Get thread ID
    mov.u32 r10, %tid.x

    // Test 1: Simple DP4A
    mov.u32 r1, 0x0201      // a = {0,0,2,1}
    mov.u32 r2, 0x0303      // b = {0,0,3,3}
    mov.u32 r3, 10          // c = 10
    dp4a.s32.s32 r0, r1, r2, r3   // r0 = 1*3 + 2*3 + 10 = 19

    // Store test 1 result
    mov.u32 r4, 0x1000
    st.global.u32 [r4], r0

    // Test 2: DP4A with larger values
    mov.u32 r1, 0x0505      // a = {0,0,5,5}
    mov.u32 r2, 0x0202      // b = {0,0,2,2}
    mov.u32 r3, 100         // c = 100
    dp4a.s32.s32 r0, r1, r2, r3   // r0 = 5*2 + 5*2 + 100 = 120

    // Store test 2 result
    add.s32 r4, r4, 4
    st.global.u32 [r4], r0

    // Test 3: DP2A - INT16 dot product
    // a = 0x00030002 (hi=3, lo=2), b = 0x00040005 (hi=4, lo=5), c = 50
    // Expected: 3*4 + 2*5 + 50 = 12 + 10 + 50 = 72
    mov.u32 r1, 0x0002      // lo = 2
    mov.u32 r5, 0x0003      // hi = 3
    shl.b32 r5, r5, 16
    or.b32 r1, r1, r5       // r1 = 0x00030002

    mov.u32 r2, 0x0005      // lo = 5
    mov.u32 r5, 0x0004      // hi = 4
    shl.b32 r5, r5, 16
    or.b32 r2, r2, r5       // r2 = 0x00040005

    mov.u32 r3, 50
    dp2a.s32.s32 r0, r1, r2, r3   // r0 = 72

    // Store test 3 result
    add.s32 r4, r4, 4
    st.global.u32 [r4], r0

    exit
