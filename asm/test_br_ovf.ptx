// Test BR_IF_OVF instruction
.entry test_br_ovf:
    mov.u32 r0, %laneid
    bra.nz r0, DONE

    // Test 1: Add causing overflow
    mov.u32 r1, 0x7FFFFFFF
    mov.u32 r2, 1
    add.s32 r3, r1, r2
    bra.ovf r0, OVERFLOW_EXPECTED

    // Should not reach here if overflow is detected
    bra FAIL

OVERFLOW_EXPECTED:
    // Test 2: Add NOT causing overflow
    mov.u32 r4, 0x10000000
    add.s32 r5, r4, r2
    bra.ovf r0, FAIL

    // Write success marker
    mov.u32 r14, 0x8000
    mov.u32 r15, 0xCAFE
    st.global.u32 [r14], r15
    bra DONE

FAIL:
    mov.u32 r14, 0x8000
    mov.u32 r15, 0xDEAD
    st.global.u32 [r14], r15

DONE:
    exit
.end
