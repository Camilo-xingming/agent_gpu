// LLM Operator: GELU Activation
// GELU(x) ≈ 0.5 * x * (1 + tanh(sqrt(2/pi) * (x + 0.044715 * x^3)))
// Simplified using tanh: GELU(x) ≈ 0.5 * x * (1 + tanh(0.7978 * x))
//
// Test values:
// x = -1.0: GELU(-1.0) ≈ -0.159
// x = 0.0:  GELU(0.0) = 0.0
// x = 1.0:  GELU(1.0) ≈ 0.841
// x = 2.0:  GELU(2.0) ≈ 1.955
//
// Store: GELU(1.0) + GELU(2.0) ≈ 2.796

.entry llm_gelu:
    // Constants:
    // 0.5f = 0x3F000000
    // 1.0f = 0x3F800000
    // 2.0f = 0x40000000
    // 0.7978f ≈ 0x3F4C (simplified as 0.75 = 0x3F400000 for 16-bit load)

    // Load 0.5f
    mov.u32 r1, 0x3F00
    shl.b32 r1, r1, 16        // r1 = 0.5f

    // Load 1.0f for (1 + tanh(...))
    mov.u32 r2, 0x3F80
    shl.b32 r2, r2, 16        // r2 = 1.0f

    // Load coefficient ~0.8 (use 0.75 = 0x3F400000)
    mov.u32 r3, 0x3F40
    shl.b32 r3, r3, 16        // r3 = 0.75f (approx sqrt(2/pi))

    // Load x0 = 1.0f
    mov.u32 r4, 0x3F80
    shl.b32 r4, r4, 16        // r4 = 1.0f

    // Load x1 = 2.0f
    mov.u32 r5, 0x4000
    shl.b32 r5, r5, 16        // r5 = 2.0f

    // Compute GELU(x0) = 0.5 * x0 * (1 + tanh(0.75 * x0))
    // Step 1: 0.75 * x0
    mul.f32 r6, r3, r4        // r6 = 0.75 * 1.0 = 0.75

    // Step 2: tanh(0.75 * x0)
    tanh.f32 r7, r6           // r7 = tanh(0.75) ≈ 0.635

    // Step 3: 1 + tanh(...)
    add.f32 r8, r2, r7        // r8 = 1.0 + 0.635 = 1.635

    // Step 4: x0 * (1 + tanh(...))
    mul.f32 r9, r4, r8        // r9 = 1.0 * 1.635 = 1.635

    // Step 5: 0.5 * x0 * (1 + tanh(...))
    mul.f32 r10, r1, r9       // r10 = GELU(1.0) ≈ 0.818

    // Compute GELU(x1) = 0.5 * x1 * (1 + tanh(0.75 * x1))
    // Step 1: 0.75 * x1
    mul.f32 r11, r3, r5       // r11 = 0.75 * 2.0 = 1.5

    // Step 2: tanh(0.75 * x1)
    tanh.f32 r12, r11         // r12 = tanh(1.5) ≈ 0.905

    // Step 3: 1 + tanh(...)
    add.f32 r13, r2, r12      // r13 = 1.0 + 0.905 = 1.905

    // Step 4: x1 * (1 + tanh(...))
    mul.f32 r14, r5, r13      // r14 = 2.0 * 1.905 = 3.81

    // Step 5: 0.5 * x1 * (1 + tanh(...))
    mul.f32 r15, r1, r14      // r15 = GELU(2.0) ≈ 1.905

    // Sum of GELU outputs
    add.f32 r16, r10, r15     // r16 = GELU(1.0) + GELU(2.0) ≈ 2.72

    // Store results
    mov.u32 r20, 0x1000
    st.global.u32 [r20], r16  // Sum of GELU outputs

    mov.u32 r21, 0x1004
    st.global.u32 [r21], r10  // GELU(1.0)

    mov.u32 r22, 0x1008
    st.global.u32 [r22], r15  // GELU(2.0)

    exit
