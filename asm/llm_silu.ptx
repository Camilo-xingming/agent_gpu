// LLM Operator: SiLU (Swish) Activation
// Used in: LLaMA, Mistral, and other modern LLMs
// SiLU(x) = x * sigmoid(x) = x / (1 + exp(-x))
//
// Using: sigmoid(x) = 1 / (1 + exp(-x))
//        exp(-x) ≈ 2^(-x * log2(e)) = 2^(-x * 1.4427)
//
// Test: x = 1.0
// sigmoid(1.0) = 1 / (1 + exp(-1)) ≈ 1 / (1 + 0.368) ≈ 0.731
// SiLU(1.0) = 1.0 * 0.731 ≈ 0.731
//
// Test: x = 2.0
// sigmoid(2.0) = 1 / (1 + exp(-2)) ≈ 1 / (1 + 0.135) ≈ 0.881
// SiLU(2.0) = 2.0 * 0.881 ≈ 1.762

.entry llm_silu:
    // Constants:
    // 1.0f = 0x3F800000
    // 2.0f = 0x40000000
    // -1.5f (approx -log2(e)) = 0xBFC00000

    // Load 1.0f
    mov.u32 r1, 0x3F80
    shl.b32 r1, r1, 16        // r1 = 1.0f

    // Load -1.5f (negative log2(e) approximation)
    mov.u32 r2, 0xBFC0
    shl.b32 r2, r2, 16        // r2 = -1.5f

    // Load x0 = 1.0f
    mov.u32 r3, 0x3F80
    shl.b32 r3, r3, 16        // r3 = 1.0f

    // Load x1 = 2.0f
    mov.u32 r4, 0x4000
    shl.b32 r4, r4, 16        // r4 = 2.0f

    // === SiLU(x0) ===
    // Step 1: -x0 * log2(e) = -1.0 * 1.5 = -1.5
    mul.f32 r5, r3, r2        // r5 = 1.0 * (-1.5) = -1.5

    // Step 2: exp(-x0) = 2^(-1.5) ≈ 0.354
    ex2.f32 r6, r5            // r6 = 2^(-1.5) ≈ 0.354

    // Step 3: 1 + exp(-x0)
    add.f32 r7, r1, r6        // r7 = 1.0 + 0.354 = 1.354

    // Step 4: sigmoid(x0) = 1 / (1 + exp(-x0))
    rcp.f32 r8, r7            // r8 = 1/1.354 ≈ 0.739

    // Step 5: SiLU(x0) = x0 * sigmoid(x0)
    mul.f32 r9, r3, r8        // r9 = 1.0 * 0.739 ≈ 0.739

    // === SiLU(x1) ===
    // Step 1: -x1 * log2(e) = -2.0 * 1.5 = -3.0
    mul.f32 r10, r4, r2       // r10 = 2.0 * (-1.5) = -3.0

    // Step 2: exp(-x1) = 2^(-3.0) = 0.125
    ex2.f32 r11, r10          // r11 = 2^(-3.0) = 0.125

    // Step 3: 1 + exp(-x1)
    add.f32 r12, r1, r11      // r12 = 1.0 + 0.125 = 1.125

    // Step 4: sigmoid(x1) = 1 / (1 + exp(-x1))
    rcp.f32 r13, r12          // r13 = 1/1.125 ≈ 0.889

    // Step 5: SiLU(x1) = x1 * sigmoid(x1)
    mul.f32 r14, r4, r13      // r14 = 2.0 * 0.889 ≈ 1.778

    // Sum of SiLU outputs
    add.f32 r15, r9, r14      // r15 = SiLU(1.0) + SiLU(2.0) ≈ 2.517

    // Store results
    mov.u32 r20, 0x1000
    st.global.u32 [r20], r15  // Sum of SiLU outputs

    mov.u32 r21, 0x1004
    st.global.u32 [r21], r9   // SiLU(1.0)

    mov.u32 r22, 0x1008
    st.global.u32 [r22], r14  // SiLU(2.0)

    exit
