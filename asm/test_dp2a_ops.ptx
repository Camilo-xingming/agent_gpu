// DP2A Operations Test - INT16 dot product
// Tests 2-way half-word dot product per B300 gap analysis
// Uses bra.nz for comparisons
// NOTE: 16-bit immediate limit - build 32-bit constants with shift+or

.entry test_dp2a_ops:
    mov.u32 r0, %laneid

    // Only lane 0 runs tests
    bra.nz r0, SKIP_TEST

    // Test 1: dp2a.s32.s32 with packed half-words
    // a = [10, 20] packed as hi=20, lo=10
    // b = [1, 1] packed
    // Build 0x0014000A (hi=20=0x14, lo=10=0x0A)
    mov.u32 r1, 0x000A      // Low half
    mov.u32 r2, 0x0014      // High half (20)
    shl.b32 r2, r2, 16
    or.b32 r1, r1, r2       // r1 = 0x0014000A

    // Build 0x00010001
    mov.u32 r2, 0x0001      // Low half
    mov.u32 r3, 0x0001      // High half
    shl.b32 r3, r3, 16
    or.b32 r2, r2, r3       // r2 = 0x00010001

    mov.u32 r3, 0
    dp2a.s32.s32 r4, r1, r2, r3

    // Expected: 10*1 + 20*1 = 30
    sub.s32 r30, r4, 30
    bra.nz r30, FAIL

    // Test 2: dp2a with multipliers
    // a = [5, 6] = hi=6, lo=5
    // b = [2, 3] = hi=3, lo=2
    // Build 0x00060005
    mov.u32 r1, 0x0005
    mov.u32 r5, 0x0006
    shl.b32 r5, r5, 16
    or.b32 r1, r1, r5       // r1 = 0x00060005

    // Build 0x00030002
    mov.u32 r2, 0x0002
    mov.u32 r5, 0x0003
    shl.b32 r5, r5, 16
    or.b32 r2, r2, r5       // r2 = 0x00030002

    mov.u32 r3, 0
    dp2a.s32.s32 r4, r1, r2, r3

    // Result = 5*2 + 6*3 = 10 + 18 = 28
    sub.s32 r30, r4, 28
    bra.nz r30, FAIL

    // Test 3: dp2a with accumulator
    // Same as Test 2 but c = 72
    mov.u32 r3, 72
    dp2a.s32.s32 r4, r1, r2, r3

    // Result = 28 + 72 = 100
    sub.s32 r30, r4, 100
    bra.nz r30, FAIL

    // Test 4: Chained dp2a operations
    // [1, 2] = 0x00020001
    mov.u32 r10, 0x0001
    mov.u32 r11, 0x0002
    shl.b32 r11, r11, 16
    or.b32 r10, r10, r11    // r10 = 0x00020001

    // [1, 1] = 0x00010001
    mov.u32 r11, 0x0001
    mov.u32 r12, 0x0001
    shl.b32 r12, r12, 16
    or.b32 r11, r11, r12    // r11 = 0x00010001

    mov.u32 r12, 0          // Accumulator

    dp2a.s32.s32 r12, r10, r11, r12    // 1*1 + 2*1 = 3
    dp2a.s32.s32 r12, r10, r11, r12    // 1*1 + 2*1 + 3 = 6

    sub.s32 r30, r12, 6
    bra.nz r30, FAIL

    // Write success marker
    mov.u32 r21, 0x2000
    mov.u32 r22, 0xCAFE
    st.global.u32 [r21], r22
    bra DONE

SKIP_TEST:
    bra DONE

FAIL:
    mov.u32 r21, 0x2000
    mov.u32 r22, 0xDEAD
    st.global.u32 [r21], r22

DONE:
    exit
.end
