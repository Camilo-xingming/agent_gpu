// RalphGPU 4x4 FP16 Matrix Multiplication Kernel - With NOPs for hazard avoidance
// C = A * B where A,B are 4x4 FP16, C is 4x4 FP32

.entry matmul_4x4_fp16:
    // Load matrix A (8 words) into r1-r8
    mov.u32 r30, 0x1000
    nop
    nop
    ld.global.u32 r1, [r30]
    add.s32 r30, r30, 4
    nop
    nop
    ld.global.u32 r2, [r30]
    add.s32 r30, r30, 4
    nop
    nop
    ld.global.u32 r3, [r30]
    add.s32 r30, r30, 4
    nop
    nop
    ld.global.u32 r4, [r30]
    add.s32 r30, r30, 4
    nop
    nop
    ld.global.u32 r5, [r30]
    add.s32 r30, r30, 4
    nop
    nop
    ld.global.u32 r6, [r30]
    add.s32 r30, r30, 4
    nop
    nop
    ld.global.u32 r7, [r30]
    add.s32 r30, r30, 4
    nop
    nop
    ld.global.u32 r8, [r30]

    // Load matrix B (8 words) into r9-r16
    mov.u32 r30, 0x1020
    nop
    nop
    ld.global.u32 r9, [r30]
    add.s32 r30, r30, 4
    nop
    nop
    ld.global.u32 r10, [r30]
    add.s32 r30, r30, 4
    nop
    nop
    ld.global.u32 r11, [r30]
    add.s32 r30, r30, 4
    nop
    nop
    ld.global.u32 r12, [r30]
    add.s32 r30, r30, 4
    nop
    nop
    ld.global.u32 r13, [r30]
    add.s32 r30, r30, 4
    nop
    nop
    ld.global.u32 r14, [r30]
    add.s32 r30, r30, 4
    nop
    nop
    ld.global.u32 r15, [r30]
    add.s32 r30, r30, 4
    nop
    nop
    ld.global.u32 r16, [r30]

    // Set C base address
    mov.u32 r30, 0x1040

    // ================================================================
    // Compute C[0][0] = A[0][0]*B[0][0] + A[0][1]*B[1][0] + A[0][2]*B[2][0] + A[0][3]*B[3][0]
    // ================================================================
    nop
    nop
    and.b32 r21, r1, 0xFFFF
    and.b32 r22, r9, 0xFFFF
    nop
    nop
    mul.f16 r20, r21, r22
    nop
    nop
    cvt.f32.f16 r20, r20

    nop
    nop
    shr.u32 r21, r1, 16
    and.b32 r22, r11, 0xFFFF
    nop
    nop
    mul.f16 r23, r21, r22
    nop
    nop
    cvt.f32.f16 r23, r23
    nop
    nop
    add.f32 r20, r20, r23

    nop
    nop
    and.b32 r21, r2, 0xFFFF
    and.b32 r22, r13, 0xFFFF
    nop
    nop
    mul.f16 r23, r21, r22
    nop
    nop
    cvt.f32.f16 r23, r23
    nop
    nop
    add.f32 r20, r20, r23

    nop
    nop
    shr.u32 r21, r2, 16
    and.b32 r22, r15, 0xFFFF
    nop
    nop
    mul.f16 r23, r21, r22
    nop
    nop
    cvt.f32.f16 r23, r23
    nop
    nop
    add.f32 r20, r20, r23

    nop
    nop
    st.global.f32 [r30], r20
    add.s32 r30, r30, 4

    // ================================================================
    // Compute C[0][1]
    // ================================================================
    nop
    nop
    and.b32 r21, r1, 0xFFFF
    shr.u32 r22, r9, 16
    nop
    nop
    mul.f16 r20, r21, r22
    nop
    nop
    cvt.f32.f16 r20, r20

    shr.u32 r21, r1, 16
    shr.u32 r22, r11, 16
    nop
    nop
    mul.f16 r23, r21, r22
    nop
    nop
    cvt.f32.f16 r23, r23
    nop
    nop
    add.f32 r20, r20, r23

    and.b32 r21, r2, 0xFFFF
    shr.u32 r22, r13, 16
    nop
    nop
    mul.f16 r23, r21, r22
    nop
    nop
    cvt.f32.f16 r23, r23
    nop
    nop
    add.f32 r20, r20, r23

    shr.u32 r21, r2, 16
    shr.u32 r22, r15, 16
    nop
    nop
    mul.f16 r23, r21, r22
    nop
    nop
    cvt.f32.f16 r23, r23
    nop
    nop
    add.f32 r20, r20, r23

    nop
    nop
    st.global.f32 [r30], r20
    add.s32 r30, r30, 4

    // For brevity, compute remaining 14 elements with simpler structure
    // C[0][2]
    nop
    nop
    and.b32 r21, r1, 0xFFFF
    and.b32 r22, r10, 0xFFFF
    nop
    mul.f16 r20, r21, r22
    nop
    cvt.f32.f16 r20, r20
    shr.u32 r21, r1, 16
    and.b32 r22, r12, 0xFFFF
    nop
    mul.f16 r23, r21, r22
    nop
    cvt.f32.f16 r23, r23
    nop
    add.f32 r20, r20, r23
    and.b32 r21, r2, 0xFFFF
    and.b32 r22, r14, 0xFFFF
    nop
    mul.f16 r23, r21, r22
    nop
    cvt.f32.f16 r23, r23
    nop
    add.f32 r20, r20, r23
    shr.u32 r21, r2, 16
    and.b32 r22, r16, 0xFFFF
    nop
    mul.f16 r23, r21, r22
    nop
    cvt.f32.f16 r23, r23
    nop
    add.f32 r20, r20, r23
    nop
    st.global.f32 [r30], r20
    add.s32 r30, r30, 4

    // C[0][3]
    nop
    and.b32 r21, r1, 0xFFFF
    shr.u32 r22, r10, 16
    nop
    mul.f16 r20, r21, r22
    nop
    cvt.f32.f16 r20, r20
    shr.u32 r21, r1, 16
    shr.u32 r22, r12, 16
    nop
    mul.f16 r23, r21, r22
    nop
    cvt.f32.f16 r23, r23
    nop
    add.f32 r20, r20, r23
    and.b32 r21, r2, 0xFFFF
    shr.u32 r22, r14, 16
    nop
    mul.f16 r23, r21, r22
    nop
    cvt.f32.f16 r23, r23
    nop
    add.f32 r20, r20, r23
    shr.u32 r21, r2, 16
    shr.u32 r22, r16, 16
    nop
    mul.f16 r23, r21, r22
    nop
    cvt.f32.f16 r23, r23
    nop
    add.f32 r20, r20, r23
    nop
    st.global.f32 [r30], r20
    add.s32 r30, r30, 4

    // Row 1: C[1][0..3]
    // C[1][0]
    nop
    and.b32 r21, r3, 0xFFFF
    and.b32 r22, r9, 0xFFFF
    nop
    mul.f16 r20, r21, r22
    nop
    cvt.f32.f16 r20, r20
    shr.u32 r21, r3, 16
    and.b32 r22, r11, 0xFFFF
    nop
    mul.f16 r23, r21, r22
    nop
    cvt.f32.f16 r23, r23
    nop
    add.f32 r20, r20, r23
    and.b32 r21, r4, 0xFFFF
    and.b32 r22, r13, 0xFFFF
    nop
    mul.f16 r23, r21, r22
    nop
    cvt.f32.f16 r23, r23
    nop
    add.f32 r20, r20, r23
    shr.u32 r21, r4, 16
    and.b32 r22, r15, 0xFFFF
    nop
    mul.f16 r23, r21, r22
    nop
    cvt.f32.f16 r23, r23
    nop
    add.f32 r20, r20, r23
    nop
    st.global.f32 [r30], r20
    add.s32 r30, r30, 4

    // C[1][1]
    nop
    and.b32 r21, r3, 0xFFFF
    shr.u32 r22, r9, 16
    nop
    mul.f16 r20, r21, r22
    nop
    cvt.f32.f16 r20, r20
    shr.u32 r21, r3, 16
    shr.u32 r22, r11, 16
    nop
    mul.f16 r23, r21, r22
    nop
    cvt.f32.f16 r23, r23
    nop
    add.f32 r20, r20, r23
    and.b32 r21, r4, 0xFFFF
    shr.u32 r22, r13, 16
    nop
    mul.f16 r23, r21, r22
    nop
    cvt.f32.f16 r23, r23
    nop
    add.f32 r20, r20, r23
    shr.u32 r21, r4, 16
    shr.u32 r22, r15, 16
    nop
    mul.f16 r23, r21, r22
    nop
    cvt.f32.f16 r23, r23
    nop
    add.f32 r20, r20, r23
    nop
    st.global.f32 [r30], r20
    add.s32 r30, r30, 4

    // C[1][2]
    nop
    and.b32 r21, r3, 0xFFFF
    and.b32 r22, r10, 0xFFFF
    nop
    mul.f16 r20, r21, r22
    nop
    cvt.f32.f16 r20, r20
    shr.u32 r21, r3, 16
    and.b32 r22, r12, 0xFFFF
    nop
    mul.f16 r23, r21, r22
    nop
    cvt.f32.f16 r23, r23
    nop
    add.f32 r20, r20, r23
    and.b32 r21, r4, 0xFFFF
    and.b32 r22, r14, 0xFFFF
    nop
    mul.f16 r23, r21, r22
    nop
    cvt.f32.f16 r23, r23
    nop
    add.f32 r20, r20, r23
    shr.u32 r21, r4, 16
    and.b32 r22, r16, 0xFFFF
    nop
    mul.f16 r23, r21, r22
    nop
    cvt.f32.f16 r23, r23
    nop
    add.f32 r20, r20, r23
    nop
    st.global.f32 [r30], r20
    add.s32 r30, r30, 4

    // C[1][3]
    nop
    and.b32 r21, r3, 0xFFFF
    shr.u32 r22, r10, 16
    nop
    mul.f16 r20, r21, r22
    nop
    cvt.f32.f16 r20, r20
    shr.u32 r21, r3, 16
    shr.u32 r22, r12, 16
    nop
    mul.f16 r23, r21, r22
    nop
    cvt.f32.f16 r23, r23
    nop
    add.f32 r20, r20, r23
    and.b32 r21, r4, 0xFFFF
    shr.u32 r22, r14, 16
    nop
    mul.f16 r23, r21, r22
    nop
    cvt.f32.f16 r23, r23
    nop
    add.f32 r20, r20, r23
    shr.u32 r21, r4, 16
    shr.u32 r22, r16, 16
    nop
    mul.f16 r23, r21, r22
    nop
    cvt.f32.f16 r23, r23
    nop
    add.f32 r20, r20, r23
    nop
    st.global.f32 [r30], r20
    add.s32 r30, r30, 4

    // Row 2: C[2][0..3]
    // C[2][0]
    nop
    and.b32 r21, r5, 0xFFFF
    and.b32 r22, r9, 0xFFFF
    nop
    mul.f16 r20, r21, r22
    nop
    cvt.f32.f16 r20, r20
    shr.u32 r21, r5, 16
    and.b32 r22, r11, 0xFFFF
    nop
    mul.f16 r23, r21, r22
    nop
    cvt.f32.f16 r23, r23
    nop
    add.f32 r20, r20, r23
    and.b32 r21, r6, 0xFFFF
    and.b32 r22, r13, 0xFFFF
    nop
    mul.f16 r23, r21, r22
    nop
    cvt.f32.f16 r23, r23
    nop
    add.f32 r20, r20, r23
    shr.u32 r21, r6, 16
    and.b32 r22, r15, 0xFFFF
    nop
    mul.f16 r23, r21, r22
    nop
    cvt.f32.f16 r23, r23
    nop
    add.f32 r20, r20, r23
    nop
    st.global.f32 [r30], r20
    add.s32 r30, r30, 4

    // C[2][1]
    nop
    and.b32 r21, r5, 0xFFFF
    shr.u32 r22, r9, 16
    nop
    mul.f16 r20, r21, r22
    nop
    cvt.f32.f16 r20, r20
    shr.u32 r21, r5, 16
    shr.u32 r22, r11, 16
    nop
    mul.f16 r23, r21, r22
    nop
    cvt.f32.f16 r23, r23
    nop
    add.f32 r20, r20, r23
    and.b32 r21, r6, 0xFFFF
    shr.u32 r22, r13, 16
    nop
    mul.f16 r23, r21, r22
    nop
    cvt.f32.f16 r23, r23
    nop
    add.f32 r20, r20, r23
    shr.u32 r21, r6, 16
    shr.u32 r22, r15, 16
    nop
    mul.f16 r23, r21, r22
    nop
    cvt.f32.f16 r23, r23
    nop
    add.f32 r20, r20, r23
    nop
    st.global.f32 [r30], r20
    add.s32 r30, r30, 4

    // C[2][2]
    nop
    and.b32 r21, r5, 0xFFFF
    and.b32 r22, r10, 0xFFFF
    nop
    mul.f16 r20, r21, r22
    nop
    cvt.f32.f16 r20, r20
    shr.u32 r21, r5, 16
    and.b32 r22, r12, 0xFFFF
    nop
    mul.f16 r23, r21, r22
    nop
    cvt.f32.f16 r23, r23
    nop
    add.f32 r20, r20, r23
    and.b32 r21, r6, 0xFFFF
    and.b32 r22, r14, 0xFFFF
    nop
    mul.f16 r23, r21, r22
    nop
    cvt.f32.f16 r23, r23
    nop
    add.f32 r20, r20, r23
    shr.u32 r21, r6, 16
    and.b32 r22, r16, 0xFFFF
    nop
    mul.f16 r23, r21, r22
    nop
    cvt.f32.f16 r23, r23
    nop
    add.f32 r20, r20, r23
    nop
    st.global.f32 [r30], r20
    add.s32 r30, r30, 4

    // C[2][3]
    nop
    and.b32 r21, r5, 0xFFFF
    shr.u32 r22, r10, 16
    nop
    mul.f16 r20, r21, r22
    nop
    cvt.f32.f16 r20, r20
    shr.u32 r21, r5, 16
    shr.u32 r22, r12, 16
    nop
    mul.f16 r23, r21, r22
    nop
    cvt.f32.f16 r23, r23
    nop
    add.f32 r20, r20, r23
    and.b32 r21, r6, 0xFFFF
    shr.u32 r22, r14, 16
    nop
    mul.f16 r23, r21, r22
    nop
    cvt.f32.f16 r23, r23
    nop
    add.f32 r20, r20, r23
    shr.u32 r21, r6, 16
    shr.u32 r22, r16, 16
    nop
    mul.f16 r23, r21, r22
    nop
    cvt.f32.f16 r23, r23
    nop
    add.f32 r20, r20, r23
    nop
    st.global.f32 [r30], r20
    add.s32 r30, r30, 4

    // Row 3: C[3][0..3]
    // C[3][0]
    nop
    and.b32 r21, r7, 0xFFFF
    and.b32 r22, r9, 0xFFFF
    nop
    mul.f16 r20, r21, r22
    nop
    cvt.f32.f16 r20, r20
    shr.u32 r21, r7, 16
    and.b32 r22, r11, 0xFFFF
    nop
    mul.f16 r23, r21, r22
    nop
    cvt.f32.f16 r23, r23
    nop
    add.f32 r20, r20, r23
    and.b32 r21, r8, 0xFFFF
    and.b32 r22, r13, 0xFFFF
    nop
    mul.f16 r23, r21, r22
    nop
    cvt.f32.f16 r23, r23
    nop
    add.f32 r20, r20, r23
    shr.u32 r21, r8, 16
    and.b32 r22, r15, 0xFFFF
    nop
    mul.f16 r23, r21, r22
    nop
    cvt.f32.f16 r23, r23
    nop
    add.f32 r20, r20, r23
    nop
    st.global.f32 [r30], r20
    add.s32 r30, r30, 4

    // C[3][1]
    nop
    and.b32 r21, r7, 0xFFFF
    shr.u32 r22, r9, 16
    nop
    mul.f16 r20, r21, r22
    nop
    cvt.f32.f16 r20, r20
    shr.u32 r21, r7, 16
    shr.u32 r22, r11, 16
    nop
    mul.f16 r23, r21, r22
    nop
    cvt.f32.f16 r23, r23
    nop
    add.f32 r20, r20, r23
    and.b32 r21, r8, 0xFFFF
    shr.u32 r22, r13, 16
    nop
    mul.f16 r23, r21, r22
    nop
    cvt.f32.f16 r23, r23
    nop
    add.f32 r20, r20, r23
    shr.u32 r21, r8, 16
    shr.u32 r22, r15, 16
    nop
    mul.f16 r23, r21, r22
    nop
    cvt.f32.f16 r23, r23
    nop
    add.f32 r20, r20, r23
    nop
    st.global.f32 [r30], r20
    add.s32 r30, r30, 4

    // C[3][2]
    nop
    and.b32 r21, r7, 0xFFFF
    and.b32 r22, r10, 0xFFFF
    nop
    mul.f16 r20, r21, r22
    nop
    cvt.f32.f16 r20, r20
    shr.u32 r21, r7, 16
    and.b32 r22, r12, 0xFFFF
    nop
    mul.f16 r23, r21, r22
    nop
    cvt.f32.f16 r23, r23
    nop
    add.f32 r20, r20, r23
    and.b32 r21, r8, 0xFFFF
    and.b32 r22, r14, 0xFFFF
    nop
    mul.f16 r23, r21, r22
    nop
    cvt.f32.f16 r23, r23
    nop
    add.f32 r20, r20, r23
    shr.u32 r21, r8, 16
    and.b32 r22, r16, 0xFFFF
    nop
    mul.f16 r23, r21, r22
    nop
    cvt.f32.f16 r23, r23
    nop
    add.f32 r20, r20, r23
    nop
    st.global.f32 [r30], r20
    add.s32 r30, r30, 4

    // C[3][3]
    nop
    and.b32 r21, r7, 0xFFFF
    shr.u32 r22, r10, 16
    nop
    mul.f16 r20, r21, r22
    nop
    cvt.f32.f16 r20, r20
    shr.u32 r21, r7, 16
    shr.u32 r22, r12, 16
    nop
    mul.f16 r23, r21, r22
    nop
    cvt.f32.f16 r23, r23
    nop
    add.f32 r20, r20, r23
    and.b32 r21, r8, 0xFFFF
    shr.u32 r22, r14, 16
    nop
    mul.f16 r23, r21, r22
    nop
    cvt.f32.f16 r23, r23
    nop
    add.f32 r20, r20, r23
    shr.u32 r21, r8, 16
    shr.u32 r22, r16, 16
    nop
    mul.f16 r23, r21, r22
    nop
    cvt.f32.f16 r23, r23
    nop
    add.f32 r20, r20, r23
    nop
    st.global.f32 [r30], r20

    exit

.end
