// Simple Atomic Test
// Test atom.add only
// Success marker: 0xCAFE at 0x2000

.entry simple_atomic_test:
    mov.u32 r0, %laneid
    bra.nz r0, DONE

    // r10 = atomic target address
    mov.u32 r10, 0x1000

    // Initialize [r10] = 100
    mov.u32 r1, 100
    st.global.u32 [r10], r1

    // atom.add: [r10] += 50, r3 = old value (should be 100)
    mov.u32 r2, 50
    atom.add.s32 r3, [r10], r2

    // Check old value == 100
    sub.s32 r30, r3, 100
    bra.nz r30, FAIL

    // Success
    mov.u32 r20, 0x2000
    mov.u32 r21, 0xCAFE
    st.global.u32 [r20], r21
    bra DONE

FAIL:
    mov.u32 r20, 0x2000
    mov.u32 r21, 0xDEAD
    st.global.u32 [r20], r21

DONE:
    exit
.end
