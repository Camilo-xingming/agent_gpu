// DP4A/DP2A Test - INT8/INT16 dot product with accumulate
// Tests ML acceleration instructions
//
// DP4A: d = a[0]*b[0] + a[1]*b[1] + a[2]*b[2] + a[3]*b[3] + c
// where a,b are packed 4xINT8 vectors
//
// Test case 1: a = {1, 2, 3, 4} = 0x04030201, b = {1, 1, 1, 1} = 0x01010101, c = 0
// Expected: 1*1 + 2*1 + 3*1 + 4*1 + 0 = 10
// Build 0x04030201: use shifts and ORs
// simpler: use smaller test values that fit in 16 bits

.entry dp4a_test:
    // Test case 1: Simple values
    // a = {0, 0, 2, 1} = 0x00000201 (1 and 2 as int8)
    // b = {0, 0, 3, 3} = 0x00000303 (3 and 3 as int8)
    // c = 10
    // Expected: 1*3 + 2*3 + 0*0 + 0*0 + 10 = 3 + 6 + 10 = 19
    mov.u32 r1, 0x0201
    mov.u32 r2, 0x0303
    mov.u32 r3, 10
    dp4a.s32.s32 r0, r1, r2, r3

    // Store result to global memory
    mov.u32 r4, 0x1000
    st.global.u32 [r4], r0

    // Test case 2: DP2A with 16-bit operands
    // a = 0x00020003 (hi=2, lo=3)
    // b = 0x00040005 (hi=4, lo=5)
    // c = 100
    // Expected: 2*4 + 3*5 + 100 = 8 + 15 + 100 = 123
    mov.u32 r1, 0x0003    // lo = 3
    mov.u32 r5, 0x0002    // hi = 2
    shl.b32 r5, r5, 16    // shift hi to upper 16 bits
    or.b32 r1, r1, r5     // r1 = 0x00020003

    mov.u32 r2, 0x0005    // lo = 5
    mov.u32 r5, 0x0004    // hi = 4
    shl.b32 r5, r5, 16
    or.b32 r2, r2, r5     // r2 = 0x00040005

    mov.u32 r3, 100
    dp2a.s32.s32 r0, r1, r2, r3
    add.s32 r4, r4, 4
    st.global.u32 [r4], r0

    exit
