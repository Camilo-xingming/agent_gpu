.entry alu_logic_test:
    // Test ADD: 10 + 5 = 15
    mov.u32 r1, 10
    mov.u32 r2, 5
    add.s32 r3, r1, r2     // r3 = 15
    mov.u32 r10, 0x1000
    st.global.u32 [r10], r3

    // Test SUB: 10 - 5 = 5
    sub.s32 r4, r1, r2     // r4 = 5
    add.s32 r10, r10, 4
    st.global.u32 [r10], r4

    // Test SHL: 1 << 3 = 8
    mov.u32 r5, 1
    mov.u32 r6, 3
    shl.b32 r7, r5, r6     // r7 = 8
    add.s32 r10, r10, 4
    st.global.u32 [r10], r7

    exit
.end
