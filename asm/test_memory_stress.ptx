// Memory operations stress test - simplified
// Tests: coalesced access, strided access, RMW
// Uses bra.nz for comparisons

.entry test_memory_stress:
    mov.u32 r0, %laneid

    // Test 1: Coalesced global memory access
    mov.u32 r1, 0x1000
    shl.b32 r2, r0, 2         // Lane offset * 4 bytes
    add.s32 r3, r1, r2        // Address = 0x1000 + lane*4

    // Write pattern: lane ID + 0x100
    add.s32 r4, r0, 0x100
    st.global.u32 [r3], r4

    // Read back and verify
    ld.global.u32 r5, [r3]
    sub.s32 r30, r5, r4
    bra.nz r30, FAIL

    // Test 2: Strided memory access
    mov.u32 r6, 0x2000
    shl.b32 r7, r0, 4         // Lane offset * 16
    add.s32 r8, r6, r7

    // Write pattern: lane ID * 2
    shl.b32 r9, r0, 1
    st.global.u32 [r8], r9

    // Read back and verify
    ld.global.u32 r10, [r8]
    sub.s32 r30, r10, r9
    bra.nz r30, FAIL

    // Test 3: Multiple writes then reads
    mov.u32 r11, 0x3000
    shl.b32 r12, r0, 4        // Lane offset * 16 (4 words)
    add.s32 r13, r11, r12

    // Write 2 values: 0xA0, 0xA1
    mov.u32 r14, 0xA0
    st.global.u32 [r13], r14
    add.s32 r15, r13, 4
    mov.u32 r16, 0xA1
    st.global.u32 [r15], r16

    // Read back
    ld.global.u32 r17, [r13]
    sub.s32 r30, r17, 0xA0
    bra.nz r30, FAIL

    ld.global.u32 r18, [r15]
    sub.s32 r30, r18, 0xA1
    bra.nz r30, FAIL

    // Test 4: Read-modify-write (lane 0 only)
    bra.nz r0, SKIP_RMW

    mov.u32 r19, 0x4000
    mov.u32 r20, 100
    st.global.u32 [r19], r20

    // Read-modify-write 3 times
    ld.global.u32 r21, [r19]
    add.s32 r21, r21, 10
    st.global.u32 [r19], r21

    ld.global.u32 r21, [r19]
    add.s32 r21, r21, 10
    st.global.u32 [r19], r21

    ld.global.u32 r21, [r19]
    add.s32 r21, r21, 10
    st.global.u32 [r19], r21

    // Final value should be 130
    ld.global.u32 r22, [r19]
    sub.s32 r30, r22, 130
    bra.nz r30, FAIL

SKIP_RMW:
    // Write success marker (only lane 0)
    bra.nz r0, SKIP_SUCCESS

    mov.u32 r23, 0x8000
    mov.u32 r24, 0xCAFE
    st.global.u32 [r23], r24

SKIP_SUCCESS:
    exit

FAIL:
    mov.u32 r23, 0x8000
    mov.u32 r24, 0xDEAD
    st.global.u32 [r23], r24
    exit
.end
