// mbarrier Test - Tests Hopper-class memory barrier instructions
// This simplified test uses mbarrier directly without predicated init
// Output: mem[0x2000 + tid*4] = tid (after mbarrier synchronization)

.entry test_mbarrier:
    // Get thread ID
    mov.u32 r0, %tid.x          // r0 = thread_id (0-31)

    // Compute output address (0x2000 + tid*4)
    shl.b32 r1, r0, 2           // r1 = tid * 4
    mov.u32 r2, 0x2000          // r2 = output base
    add.s32 r2, r2, r1          // r2 = 0x2000 + tid*4

    // Setup mbarrier parameters
    // mbarrier at shared memory address 0 (in r3)
    // For this simplified test, we use address with bits [4+] encoding barrier ID
    // barrier_idx = addr[4 +: 3], so addr=0x10 gives barrier 1, addr=0x20 gives barrier 2
    // We use addr=0x10 (16) which gives barrier_idx=1
    mov.u32 r3, 16              // r3 = barrier address (16 = 0x10, barrier_idx=1)
    mov.u32 r4, 32              // r4 = expected count (32 threads)
    mov.u32 r5, 0               // r5 = phase (0)

    // All threads try to init - only one actually succeeds per barrier
    // The mbarrier init operation is idempotent (multiple inits just reset state)
    mbarrier.init [r3], r4      // Initialize barrier at addr r3 with count r4

    // All threads arrive at the barrier
    mbarrier.arrive [r3]        // Signal arrival at barrier

    // Wait for barrier completion using try_wait
    // mbarrier.try_wait blocks until barrier completes
    mbarrier.try_wait [r3], r5  // Wait on barrier at r3, phase r5

    // Store result to global memory
    st.global.s32 [r2], r0      // out[tid] = tid

    exit
