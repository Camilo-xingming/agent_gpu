// DP4A Signed Test - INT8 dot product with signed values
// Tests signed byte multiplications per B300 gap analysis
// Uses bra.nz for comparisons
// NOTE: 16-bit immediate limit - build 32-bit constants with shift+or

.entry test_dp4a_signed:
    mov.u32 r0, %laneid

    // Only lane 0 runs tests
    bra.nz r0, SKIP_TEST

    // Test 1: dp4a.s32.s32 with positive values
    // a = [1, 2, 3, 4] (packed as 0x04030201)
    // b = [1, 1, 1, 1] (packed as 0x01010101)
    // Build 0x04030201 using 16-bit parts
    mov.u32 r1, 0x0201      // Low half
    mov.u32 r2, 0x0403      // High half
    shl.b32 r2, r2, 16
    or.b32 r1, r1, r2       // r1 = 0x04030201

    // Build 0x01010101
    mov.u32 r2, 0x0101      // Low half
    mov.u32 r3, 0x0101      // High half
    shl.b32 r3, r3, 16
    or.b32 r2, r2, r3       // r2 = 0x01010101

    mov.u32 r3, 0           // Accumulator
    dp4a.s32.s32 r4, r1, r2, r3

    // Expected: 1+2+3+4 = 10
    sub.s32 r30, r4, 10
    bra.nz r30, FAIL

    // Test 2: dp4a with accumulator
    mov.u32 r3, 100
    dp4a.s32.s32 r4, r1, r2, r3
    // Expected: 10 + 100 = 110
    sub.s32 r30, r4, 110
    bra.nz r30, FAIL

    // Test 3: dp4a with negative bytes (signed)
    // a = [-1, 1, -1, 1] = [0xFF, 0x01, 0xFF, 0x01]
    // Build 0x01FF01FF
    mov.u32 r1, 0x01FF      // Low half
    mov.u32 r5, 0x01FF      // High half
    shl.b32 r5, r5, 16
    or.b32 r1, r1, r5       // r1 = 0x01FF01FF

    mov.u32 r3, 0
    dp4a.s32.s32 r4, r1, r2, r3
    // Result = -1 + 1 + (-1) + 1 = 0
    bra.nz r4, FAIL

    // Test 4: Chain of dp4a (accumulation)
    // All 2s: 0x02020202
    mov.u32 r10, 0x0202
    mov.u32 r11, 0x0202
    shl.b32 r11, r11, 16
    or.b32 r10, r10, r11    // r10 = 0x02020202

    mov.u32 r12, 0          // Accumulator

    dp4a.s32.s32 r12, r2, r2, r12    // 1*1+1*1+1*1+1*1 = 4
    dp4a.s32.s32 r12, r10, r2, r12   // 2*1+2*1+2*1+2*1 + 4 = 12

    sub.s32 r30, r12, 12
    bra.nz r30, FAIL

    // Write success marker
    mov.u32 r21, 0x2000
    mov.u32 r22, 0xCAFE
    st.global.u32 [r21], r22
    bra DONE

SKIP_TEST:
    bra DONE

FAIL:
    mov.u32 r21, 0x2000
    mov.u32 r22, 0xDEAD
    st.global.u32 [r21], r22

DONE:
    exit
.end
