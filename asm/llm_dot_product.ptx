// LLM Operator Test 1: Vector Dot Product using DP4A
// Computes dot product of two INT8 vectors using dp4a accumulation
// Used in: Quantized attention, INT8 inference
//
// Test: a = [1,2,0,0], b = [3,3,0,0], c = 10
// dp4a result: 1*3 + 2*3 + 0*0 + 0*0 + 10 = 3 + 6 + 10 = 19
// Then add another dp4a: a2 = [1,1,0,0], b2 = [2,2,0,0]
// = 1*2 + 1*2 + 0 + 0 + 19 = 23

.entry llm_dot_product:
    // Pack first vector: a[0:3] = [1,2,0,0] -> 0x0201
    mov.u32 r1, 0x0201
    // Pack second vector: b[0:3] = [3,3,0,0] -> 0x0303
    mov.u32 r2, 0x0303
    // Initialize accumulator
    mov.u32 r3, 10

    // First dp4a: r0 = 1*3 + 2*3 + 0 + 0 + 10 = 19
    dp4a.s32.s32 r0, r1, r2, r3

    // Pack more values: a2 = [1,1,0,0] -> 0x0101, b2 = [2,2,0,0] -> 0x0202
    mov.u32 r4, 0x0101
    mov.u32 r5, 0x0202

    // Second dp4a: r0 = 1*2 + 1*2 + 0 + 0 + 19 = 23
    // Use r0 as both input and output accumulator
    dp4a.s32.s32 r0, r4, r5, r0

    // Store result to memory address 0x1000
    mov.u32 r6, 0x1000
    st.global.u32 [r6], r0

    exit
