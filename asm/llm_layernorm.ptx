// LLM Operator: LayerNorm
// Computes: y = (x - mean) * rsqrt(var + eps) * gamma + beta
// Simplified: y = (x - mean) * rsqrt(var) for gamma=1, beta=0, eps=0
//
// Input: x = [1.0, 2.0, 3.0, 4.0]
// mean = (1+2+3+4)/4 = 2.5
// var = ((1-2.5)^2 + (2-2.5)^2 + (3-2.5)^2 + (4-2.5)^2) / 4
//     = (2.25 + 0.25 + 0.25 + 2.25) / 4 = 1.25
// rsqrt(1.25) = 1/sqrt(1.25) ≈ 0.894
// y0 = (1.0 - 2.5) * 0.894 = -1.5 * 0.894 ≈ -1.342
// y1 = (2.0 - 2.5) * 0.894 = -0.5 * 0.894 ≈ -0.447
// y2 = (3.0 - 2.5) * 0.894 =  0.5 * 0.894 ≈  0.447
// y3 = (4.0 - 2.5) * 0.894 =  1.5 * 0.894 ≈  1.342
// Sum of squares of normalized values should be 4.0 (n)

.entry llm_layernorm:
    // Load input values: x = [1.0, 2.0, 3.0, 4.0]
    // 1.0f = 0x3F800000, 2.0f = 0x40000000, 3.0f = 0x40400000, 4.0f = 0x40800000

    // x0 = 1.0f
    mov.u32 r1, 0x3F80
    shl.b32 r1, r1, 16

    // x1 = 2.0f
    mov.u32 r2, 0x4000
    shl.b32 r2, r2, 16

    // x2 = 3.0f
    mov.u32 r3, 0x4040
    shl.b32 r3, r3, 16

    // x3 = 4.0f
    mov.u32 r4, 0x4080
    shl.b32 r4, r4, 16

    // Compute sum for mean: sum = x0 + x1 + x2 + x3
    add.f32 r5, r1, r2        // r5 = 1.0 + 2.0 = 3.0
    add.f32 r5, r5, r3        // r5 = 3.0 + 3.0 = 6.0
    add.f32 r5, r5, r4        // r5 = 6.0 + 4.0 = 10.0

    // Load 4.0f for division (n=4)
    mov.u32 r6, 0x4080
    shl.b32 r6, r6, 16        // r6 = 4.0f

    // Compute mean = sum / n
    div.f32 r7, r5, r6        // r7 = 10.0 / 4.0 = 2.5

    // Compute (x - mean) for each element
    sub.f32 r8, r1, r7        // r8 = 1.0 - 2.5 = -1.5
    sub.f32 r9, r2, r7        // r9 = 2.0 - 2.5 = -0.5
    sub.f32 r10, r3, r7       // r10 = 3.0 - 2.5 = 0.5
    sub.f32 r11, r4, r7       // r11 = 4.0 - 2.5 = 1.5

    // Compute variance: var = sum((x-mean)^2) / n
    mul.f32 r12, r8, r8       // r12 = (-1.5)^2 = 2.25
    mul.f32 r13, r9, r9       // r13 = (-0.5)^2 = 0.25
    mul.f32 r14, r10, r10     // r14 = (0.5)^2 = 0.25
    mul.f32 r15, r11, r11     // r15 = (1.5)^2 = 2.25

    add.f32 r16, r12, r13     // r16 = 2.25 + 0.25 = 2.5
    add.f32 r16, r16, r14     // r16 = 2.5 + 0.25 = 2.75
    add.f32 r16, r16, r15     // r16 = 2.75 + 2.25 = 5.0

    div.f32 r17, r16, r6      // r17 = var = 5.0 / 4.0 = 1.25

    // Compute rsqrt(var)
    rsqrt.f32 r18, r17        // r18 = rsqrt(1.25) ≈ 0.894

    // Normalize: y = (x - mean) * rsqrt(var)
    mul.f32 r19, r8, r18      // y0 = -1.5 * 0.894 ≈ -1.342
    mul.f32 r20, r9, r18      // y1 = -0.5 * 0.894 ≈ -0.447
    mul.f32 r21, r10, r18     // y2 = 0.5 * 0.894 ≈ 0.447
    mul.f32 r22, r11, r18     // y3 = 1.5 * 0.894 ≈ 1.342

    // Verify: sum of y^2 should be n = 4.0
    mul.f32 r23, r19, r19     // y0^2
    mul.f32 r24, r20, r20     // y1^2
    mul.f32 r25, r21, r21     // y2^2
    mul.f32 r26, r22, r22     // y3^2

    add.f32 r27, r23, r24
    add.f32 r27, r27, r25
    add.f32 r27, r27, r26     // r27 = sum of squares ≈ 4.0

    // Store results
    mov.u32 r28, 0x1000
    st.global.u32 [r28], r27  // sum of y^2 (should be ~4.0)

    mov.u32 r28, 0x1004
    st.global.u32 [r28], r7   // mean = 2.5

    mov.u32 r28, 0x1008
    st.global.u32 [r28], r17  // variance = 1.25

    mov.u32 r28, 0x100c
    st.global.u32 [r28], r19  // y0 (normalized)

    exit
