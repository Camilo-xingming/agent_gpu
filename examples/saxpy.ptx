// RalphGPU Example: SAXPY (Single-precision A*X Plus Y)
// Y[i] = a * X[i] + Y[i]
//
// Memory layout:
// - X array: 0x0000 - 0x007F (32 elements * 4 bytes)
// - Y array: 0x1000 - 0x107F (32 elements * 4 bytes)
//
// Constants used by this kernel:
// - a = 3

.entry saxpy:
    // Get thread ID
    mov.u32 r0, %tid.x

    // byte offset = tid * 4
    shl.b32 r1, r0, 2

    // X[i]
    ld.global.s32 r2, [r1]
    ld.global.s32 r7, [r1]      // warm-cache reload for hit-rate visibility

    // a * X[i]  (a = 3)
    mov.u32 r20, 3
    mul.lo.s32 r3, r20, r7

    // Y[i]
    mov.u32 r21, 0x1000
    add.s32 r4, r1, r21
    ld.global.s32 r5, [r4]

    // Y[i] = a*X[i] + Y[i]
    add.s32 r6, r3, r5

    // store result back to Y[i]
    st.global.s32 [r4], r6

    exit
