//
// Triton Vector Add Kernel - Sample PTX Output
// Generated by: Triton compiler (simulated for RalphGPU testing)
// Target: sm_80 (Ampere)
//
// This PTX file demonstrates the instruction patterns Triton generates
// for a simple vector addition kernel. RalphGPU supports all instructions
// used in this kernel.
//
// Reference: doc/triton_ptx_compatibility_analysis.md Section 6.1
//
// Equivalent Triton kernel:
// @triton.jit
// def add_kernel(x_ptr, y_ptr, output_ptr, n_elements, BLOCK_SIZE: tl.constexpr):
//     pid = tl.program_id(axis=0)
//     block_start = pid * BLOCK_SIZE
//     offsets = block_start + tl.arange(0, BLOCK_SIZE)
//     mask = offsets < n_elements
//     x = tl.load(x_ptr + offsets, mask=mask)
//     y = tl.load(y_ptr + offsets, mask=mask)
//     output = x + y
//     tl.store(output_ptr + offsets, output, mask=mask)
//

.version 7.8
.target sm_80
.address_size 64

// Kernel parameter space
.visible .entry triton_vadd_kernel(
    .param .u64 triton_vadd_kernel_param_0,  // x_ptr
    .param .u64 triton_vadd_kernel_param_1,  // y_ptr
    .param .u64 triton_vadd_kernel_param_2,  // output_ptr
    .param .u32 triton_vadd_kernel_param_3   // n_elements
)
{
    // Register declarations
    .reg .pred      %p<4>;
    .reg .b32       %r<16>;
    .reg .f32       %f<8>;
    .reg .b64       %rd<16>;

    // =========================================================================
    // Block 0: Load kernel parameters
    // =========================================================================

    // Load pointer to input array X
    ld.param.u64    %rd1, [triton_vadd_kernel_param_0];

    // Load pointer to input array Y
    ld.param.u64    %rd2, [triton_vadd_kernel_param_1];

    // Load pointer to output array
    ld.param.u64    %rd3, [triton_vadd_kernel_param_2];

    // Load number of elements
    ld.param.u32    %r1, [triton_vadd_kernel_param_3];

    // =========================================================================
    // Block 1: Compute thread index and bounds mask
    // =========================================================================

    // Get block ID (program_id in Triton)
    mov.u32         %r2, %ctaid.x;

    // Get thread ID within block
    mov.u32         %r3, %tid.x;

    // Compute global index: idx = block_id * BLOCK_SIZE + thread_id
    // BLOCK_SIZE = 16 (constexpr in Triton)
    mad.lo.s32      %r4, %r2, 16, %r3;

    // Compute bounds mask: mask = (idx < n_elements)
    setp.lt.s32     %p1, %r4, %r1;

    // =========================================================================
    // Block 2: Load input vectors (masked)
    // =========================================================================

    // Compute byte offset: offset = idx * 4 (sizeof(float))
    shl.b32         %r5, %r4, 2;

    // Convert to 64-bit for address computation
    cvt.u64.u32     %rd4, %r5;

    // Compute address of x[idx]
    add.s64         %rd5, %rd1, %rd4;

    // Compute address of y[idx]
    add.s64         %rd6, %rd2, %rd4;

    // Masked load of x[idx] - only execute if idx < n_elements
    // Triton uses predicated loads for bounds checking
    @%p1 ld.global.f32  %f1, [%rd5];

    // Masked load of y[idx]
    @%p1 ld.global.f32  %f2, [%rd6];

    // =========================================================================
    // Block 3: Vector addition
    // =========================================================================

    // Compute output = x + y
    add.f32         %f3, %f1, %f2;

    // =========================================================================
    // Block 4: Store result (masked)
    // =========================================================================

    // Compute address of output[idx]
    add.s64         %rd7, %rd3, %rd4;

    // Masked store of result
    @%p1 st.global.f32  [%rd7], %f3;

    // =========================================================================
    // Block 5: Exit
    // =========================================================================

    exit;
}

//
// RalphGPU Instruction Support Status:
// =====================================
//
// Memory Operations:
//   [SUPPORTED] ld.param.u64      - Load kernel parameter (64-bit)
//   [SUPPORTED] ld.param.u32      - Load kernel parameter (32-bit)
//   [SUPPORTED] ld.global.f32     - Global memory load (32-bit float)
//   [SUPPORTED] st.global.f32     - Global memory store (32-bit float)
//
// Compute Operations:
//   [SUPPORTED] mov.u32           - Move 32-bit integer
//   [SUPPORTED] mad.lo.s32        - Multiply-add low (signed 32-bit)
//   [SUPPORTED] shl.b32           - Shift left (32-bit)
//   [SUPPORTED] cvt.u64.u32       - Convert unsigned 32-bit to 64-bit
//   [SUPPORTED] add.s64           - Add signed 64-bit
//   [SUPPORTED] add.f32           - Add 32-bit float
//
// Control Flow:
//   [SUPPORTED] setp.lt.s32       - Set predicate less-than (signed 32-bit)
//   [SUPPORTED] @%p <instr>       - Predicated instruction execution
//   [SUPPORTED] exit              - Kernel exit
//
// Special Registers:
//   [SUPPORTED] %ctaid.x          - Block ID in X dimension
//   [SUPPORTED] %tid.x            - Thread ID in X dimension
//
// All instructions in this kernel are fully supported by RalphGPU.
// See doc/triton_ptx_compatibility_analysis.md for complete compatibility matrix.
//
